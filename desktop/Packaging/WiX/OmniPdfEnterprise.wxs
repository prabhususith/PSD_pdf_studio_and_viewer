<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Omni PDF Studio Enterprise"
           Manufacturer="Omni Studio Inc."
           Version="1.0.0.0"
           UpgradeCode="9F8A8B7C-6D5E-4F3A-2B1C-0D9E8F7A6B5C"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Omni PDF Studio" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="1A2B3C4D-5E6F-7A8B-9C0D-1E2F3A4B5C6D" Bitness="always64">
        <File Id="omni_pdf.exe"
              Source="P:\prabhu\projects\git\Omni PDF Desktop\build\dist\portable\omni_pdf.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Omni PDF Studio Enterprise Core">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>
