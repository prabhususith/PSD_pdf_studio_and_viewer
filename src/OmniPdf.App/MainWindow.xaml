<Window x:Class="OmniPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omni PDF Studio - High-Performance Vector PDF Engine"
        Height="850" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#FFFFFF"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Tab Bar -->
            <RowDefinition Height="Auto"/> <!-- Main Ribbon Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Search Bar -->
            <RowDefinition Height="*"/>    <!-- Main Viewport + Sidebar -->
            <RowDefinition Height="28"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Multi-Tab Document Bar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#383838" BorderThickness="0,0,0,1" Padding="6,4,6,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,16,4">
                    <TextBlock Text="Omni PDF Studio" FontWeight="Bold" FontSize="14" Foreground="#4CC2FF" VerticalAlignment="Center"/>
                    <TextBlock Text=" v1.0.0" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <Button x:Name="BtnNewTab" Content="+" Width="28" Height="26" DockPanel.Dock="Right" 
                        Background="#333333" Foreground="White" BorderBrush="#444444" Margin="4,0,4,4" Click="BtnNewTab_Click"/>

                <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="TabList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E1E1E" CornerRadius="4,4,0,0" BorderBrush="#383838" BorderThickness="1,1,1,0" Padding="12,4,8,4" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Foreground="#DDDDDD" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="x" Width="16" Height="16" Margin="8,0,0,0" Background="Transparent" 
                                            Foreground="#888888" BorderThickness="0" Tag="{Binding}" Click="BtnCloseTab_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 2. Action Ribbon Toolbar -->
        <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- File Operations -->
                <Button x:Name="BtnOpenFile" Content="Open PDF" Margin="2" Padding="10,4" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnOpenFile_Click"/>
                <Button x:Name="BtnSaveFile" Content="Save Incremental" Margin="2" Padding="10,4" Background="#0078D4" Foreground="White" BorderThickness="0" Click="BtnSaveFile_Click"/>

                <Separator Width="1" Height="22" Background="#555555" Margin="8,0"/>

                <!-- Annotations -->
                <Button x:Name="BtnToolPointer" Content="Pointer" Margin="2" Padding="8,4" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnTool_Click"/>
                <Button x:Name="BtnToolHighlight" Content="Highlight" Margin="2" Padding="8,4" Background="#3E3E42" Foreground="#FFE600" BorderThickness="0" Click="BtnTool_Click"/>
                <Button x:Name="BtnToolInk" Content="Vector Ink" Margin="2" Padding="8,4" Background="#3E3E42" Foreground="#FF5555" BorderThickness="0" Click="BtnTool_Click"/>
                <Button x:Name="BtnToolSticky" Content="Sticky Note" Margin="2" Padding="8,4" Background="#3E3E42" Foreground="#FFAA00" BorderThickness="0" Click="BtnTool_Click"/>
                <Button x:Name="BtnToolSignature" Content="PKCS#7 Sign" Margin="2" Padding="8,4" Background="#2B579A" Foreground="White" BorderThickness="0" Click="BtnTool_Click"/>

                <Separator Width="1" Height="22" Background="#555555" Margin="8,0"/>

                <!-- Page Operations -->
                <Button x:Name="BtnRotatePage" Content="Rotate 90°" Margin="2" Padding="8,4" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnRotatePage_Click"/>
                <Button x:Name="BtnPageOrganizer" Content="Page Organizer" Margin="2" Padding="8,4" Background="#008080" Foreground="White" BorderThickness="0" Click="BtnPageOrganizer_Click"/>

                <Separator Width="1" Height="22" Background="#555555" Margin="8,0"/>

                <!-- Enhanced Scanner & Converter Tools -->
                <Button x:Name="BtnScanner" Content="Camera Scanner" Margin="2" Padding="8,4" Background="#68217A" Foreground="White" BorderThickness="0" Click="BtnScanner_Click"/>
                <Button x:Name="BtnTextConverter" Content="Text Converter (PDF &lt;-&gt; Text)" Margin="2" Padding="8,4" Background="#107C41" Foreground="White" BorderThickness="0" Click="BtnTextConverter_Click"/>

                <Separator Width="1" Height="22" Background="#555555" Margin="8,0"/>

                <!-- Themes -->
                <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="4,0" Foreground="#AAAAAA" FontSize="11"/>
                <ComboBox x:Name="CmbTheme" Width="120" Margin="2" SelectionChanged="CmbTheme_SelectionChanged">
                    <ComboBoxItem Content="Fluent Dark" IsSelected="True"/>
                    <ComboBoxItem Content="OLED Black"/>
                    <ComboBoxItem Content="Sepia Reading"/>
                    <ComboBoxItem Content="Windows Mica"/>
                </ComboBox>

                <Separator Width="1" Height="22" Background="#555555" Margin="8,0"/>

                <!-- Zoom Controls -->
                <Button x:Name="BtnZoomOut" Content="-" Width="26" Height="24" Margin="2" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnZoomOut_Click"/>
                <TextBlock x:Name="TxtZoomLevel" Text="100%" Width="45" TextAlignment="Center" VerticalAlignment="Center" Foreground="#DDDDDD" FontSize="11"/>
                <Button x:Name="BtnZoomIn" Content="+" Width="26" Height="24" Margin="2" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnZoomIn_Click"/>

                <Button x:Name="BtnToggleSearch" Content="Find (Ctrl+F)" Margin="10,2,2,2" Padding="8,4" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnToggleSearch_Click"/>
            </WrapPanel>
        </Border>

        <!-- 3. In-Document Search Bar -->
        <Border x:Name="SearchPanel" Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="12,6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search Document:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAAAAA" FontSize="12"/>
                <TextBox x:Name="TxtSearchQuery" Width="260" Background="#1E1E1E" Foreground="White" BorderBrush="#444444" Padding="6,2" KeyUp="TxtSearchQuery_KeyUp"/>
                <Button x:Name="BtnFindNext" Content="Next Match" Margin="8,0,4,0" Padding="8,2" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnFindNext_Click"/>
                <TextBlock x:Name="TxtMatchCount" Text="0 matches" VerticalAlignment="Center" Margin="8,0" Foreground="#888888" FontSize="11"/>
                <Button x:Name="BtnCloseSearch" Content="Close" Margin="8,0" Padding="8,2" Background="Transparent" Foreground="#888888" BorderThickness="0" Click="BtnCloseSearch_Click"/>
            </StackPanel>
        </Border>

        <!-- 4. Core Viewport and Thumbnail Navigation -->
        <Grid Grid.Row="3" Background="#181818">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/> <!-- Thumbnails Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Viewport -->
            </Grid.ColumnDefinitions>

            <!-- Thumbnails Sidebar -->
            <Border Grid.Column="0" Background="#202020" BorderBrush="#333333" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock Text="PAGE THUMBNAILS" DockPanel.Dock="Top" FontSize="11" FontWeight="SemiBold" Foreground="#888888" Margin="12,10,0,6"/>
                    <ListBox x:Name="ThumbnailList" Background="Transparent" BorderThickness="0" Margin="4" SelectionChanged="ThumbnailList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" Width="140" Height="190" Margin="6" CornerRadius="3" BorderBrush="#555555" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" Foreground="#CCCCCC" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="10" Foreground="#555555"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main Canvas Viewport -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#181818" Padding="32">
                <Grid x:Name="CanvasContainer" HorizontalAlignment="Center">
                    <!-- Page Card -->
                    <Border x:Name="PageBorder" Width="612" Height="792" Background="#FAFAFA" CornerRadius="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
                        </Border.Effect>

                        <Grid>
                            <!-- Document Page Content Text -->
                            <TextBox x:Name="TxtPageContent" Margin="48" Background="Transparent" Foreground="#222222" 
                                     BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" FontFamily="Georgia"/>

                            <!-- Interactive Ink & Annotation Overlay Canvas -->
                            <InkCanvas x:Name="PageInkCanvas" Background="Transparent" IsHitTestVisible="False"/>

                            <!-- PKCS#7 Signature Badge if stamped -->
                            <Border x:Name="SignatureBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                    Margin="24" Background="#EBF3FC" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="4" Padding="10,6" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓ PKCS#7 Verified" FontWeight="Bold" Foreground="#0078D4" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 5. Status Bar -->
        <Border Grid.Row="4" Background="#0078D4" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusPage" Text="Page 1 of 3" Foreground="White" FontSize="11" Margin="0,0,16,0"/>
                <TextBlock x:Name="StatusLru" Text="LRU Cache: 0.8 MB / 64 MB Cap" Foreground="#E0E0E0" FontSize="11" Margin="0,0,16,0"/>
                <TextBlock Text="PKCS#7 Detached Signature Engine: Ready" Foreground="#E0E0E0" FontSize="11" Margin="0,0,16,0"/>
                <TextBlock Text="Windows 10/11 x64 &amp; Android 6.0+ (Redmi Note 4 Snapdragon 625)" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#E0E0E0" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
