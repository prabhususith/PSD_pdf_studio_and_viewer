<Window x:Class="OmniPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSD PDF Studio &amp; Viewer - Enterprise Edition"
        Height="590" Width="1140" MinHeight="420" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBgBrush}" 
        Foreground="{DynamicResource WindowFgBrush}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Dynamic Theme Brushes (Instantiated with default Fluent Dark values) -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#0F0F12"/>
        <SolidColorBrush x:Key="WindowFgBrush" Color="#ECECEF"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#18181B"/>
        <SolidColorBrush x:Key="HeaderFgBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="MenuBgBrush" Color="#18181B"/>
        <SolidColorBrush x:Key="MenuFgBrush" Color="#ECECEF"/>
        <SolidColorBrush x:Key="SubmenuBgBrush" Color="#27272A"/>
        <SolidColorBrush x:Key="SubmenuFgBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="ItemHoverBgBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="NavRailBgBrush" Color="#18181B"/>
        <SolidColorBrush x:Key="CanvasBgBrush" Color="#09090B"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#18181B"/>
        <SolidColorBrush x:Key="BorderBrushDefault" Color="#27272A"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#3F3F46"/>
        <SolidColorBrush x:Key="AccentBrushDefault" Color="#0284C7"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0369A1"/>
        <SolidColorBrush x:Key="StatusBarBgBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="StatusBarFgBrush" Color="#FFFFFF"/>

        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#52525B"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowFgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBrushDefault}"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Rail Button Style -->
        <Style x:Key="NavRailBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Native Menu High-Contrast Style -->
        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderFgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <!-- MenuItem TopLevelHeader Template (File, Edit, View, Tools, Help on the Main Menu Bar) -->
        <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="8,4" Margin="1,0" SnapsToDevicePixels="True">
                <Grid VerticalAlignment="Center">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom" PopupAnimation="Fade">
                        <Border x:Name="SubMenuBorder" Background="{DynamicResource SubmenuBgBrush}" 
                                BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" 
                                CornerRadius="8" Padding="4,6" MinWidth="230" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- MenuItem TopLevelItem Template -->
        <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="8,4" Margin="1,0" SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- MenuItem SubmenuItem Template (Dropdown and ContextMenu items) -->
        <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
            <Border x:Name="templateRoot" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="8,5" Margin="2,1" SnapsToDevicePixels="True">
                <Grid TextElement.Foreground="{DynamicResource SubmenuFgBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="menuItemContent" Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" 
                                      VerticalAlignment="Center" Margin="6,0,16,0" 
                                      TextElement.Foreground="{DynamicResource SubmenuFgBrush}"/>
                    <TextBlock x:Name="menuItemGesture" Grid.Column="1" Text="{TemplateBinding InputGestureText}" 
                               VerticalAlignment="Center" Margin="16,0,6,0" FontSize="10" 
                               Foreground="{DynamicResource SubmenuFgBrush}" Opacity="0.7"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                    <Setter TargetName="menuItemContent" Property="TextElement.Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                    <Setter TargetName="menuItemGesture" Property="Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- MenuItem SubmenuHeader Template (Items that open nested submenus like Themes & Skins) -->
        <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
            <Border x:Name="templateRoot" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="8,5" Margin="2,1" SnapsToDevicePixels="True">
                <Grid TextElement.Foreground="{DynamicResource SubmenuFgBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="headerContent" Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" 
                                      VerticalAlignment="Center" Margin="6,0,12,0" 
                                      TextElement.Foreground="{DynamicResource SubmenuFgBrush}"/>
                    <TextBlock x:Name="headerGesture" Grid.Column="1" Text="{TemplateBinding InputGestureText}" 
                               VerticalAlignment="Center" Margin="12,0,4,0" FontSize="10" 
                               Foreground="{DynamicResource SubmenuFgBrush}" Opacity="0.7"/>
                    <TextBlock Grid.Column="2" Text="▸" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource SubmenuFgBrush}" Opacity="0.85"/>

                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Right" PopupAnimation="Fade">
                        <Border x:Name="SubMenuBorder" Background="{DynamicResource SubmenuBgBrush}" 
                                BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" 
                                CornerRadius="8" Padding="4,6" MinWidth="180" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                    <Setter TargetName="headerContent" Property="TextElement.Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                    <Setter TargetName="headerGesture" Property="Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Master MenuItem Style applying high-contrast dynamic themes -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource HeaderFgBrush}"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.TopLevelItemTemplateKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource HeaderFgBrush}"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Native ContextMenu High-Contrast Dynamic Styles -->
        <Style TargetType="{x:Type ContextMenu}">
            <Style.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                    <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}"/>
                </Style>
            </Style.Resources>
            <Setter Property="Background" Value="{DynamicResource SubmenuBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{DynamicResource SubmenuBgBrush}" 
                                BorderBrush="{DynamicResource BorderBrushLight}" 
                                BorderThickness="1" CornerRadius="8" Padding="4,6" 
                                MinWidth="220" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Background="{DynamicResource BorderBrushLight}" Height="1" Margin="6,4" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic High-Contrast ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="4" SnapsToDevicePixels="True">
                <Border x:Name="splitBorder" Width="20" HorizontalAlignment="Right" SnapsToDevicePixels="True">
                    <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0 Z" 
                          Fill="{DynamicResource WindowFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource AccentBrushDefault}"/>
                    <Setter TargetName="arrow" Property="Opacity" Value="1.0"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource AccentBrushDefault}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dynamic High-Contrast Modern ComboBox Template -->
        <ControlTemplate x:Key="ModernComboBoxTemplate" TargetType="{x:Type ComboBox}">
            <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                <ToggleButton x:Name="toggleButton" Background="{TemplateBinding Background}" 
                              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                              Template="{StaticResource ComboBoxToggleButtonTemplate}" 
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                              ClickMode="Press" Focusable="False"/>
                <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" 
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                  Margin="8,2,22,2" IsHitTestVisible="False" 
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" 
                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                       Placement="Bottom" PopupAnimation="Fade">
                    <Border x:Name="dropDownBorder" Background="{DynamicResource SubmenuBgBrush}" 
                            BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" 
                            CornerRadius="6" Padding="3" MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                            MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
                        </Border.Effect>
                        <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- High-Contrast Dynamic ComboBoxItem Style (100% Theme Synchronized Text Visibility) -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="Transparent" BorderThickness="0" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1,1" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource SubmenuFgBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SubmenuFgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrushDefault}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Contrast Dynamic ComboBox Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template" Value="{StaticResource ModernComboBoxTemplate}"/>
        </Style>

        <!-- Dashboard ItemsPanel Templates -->
        <ItemsPanelTemplate x:Key="WrapPanelHost">
            <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="StackPanelHost">
            <VirtualizingStackPanel Orientation="Vertical" IsItemsHost="True"/>
        </ItemsPanelTemplate>

        <!-- Dashboard View Mode 1: Responsive Card Grid -->
        <DataTemplate x:Key="DashboardGridTemplate">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" 
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Width="320" Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Row: Badge + Title + Open Button -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Border Width="38" Height="36" Background="{DynamicResource AccentBrushDefault}" CornerRadius="5" Margin="0,0,10,0" DockPanel.Dock="Left">
                            <TextBlock Text="{Binding FormatBadge}" FontWeight="Bold" FontSize="10" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right" Content="Open" Style="{StaticResource AccentBtn}" Padding="8,3" VerticalAlignment="Top"
                                Tag="{Binding FilePath}" Click="BtnOpenLibraryItem_Click"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource HeaderFgBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                            <TextBlock Text="{Binding PageCountDisplay}" FontSize="9.5" Foreground="#A1A1AA" Margin="0,1,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Middle Row: File Path -->
                    <TextBlock Grid.Row="1" Text="{Binding FilePath}" FontSize="9.5" Foreground="#71717A" 
                               Margin="0,6,0,6" MaxWidth="290" TextTrimming="CharacterEllipsis"/>

                    <!-- Bottom Row: Metadata & Quick Actions -->
                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <Border Background="#27272A" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                <TextBlock Text="{Binding FormattedSize}" FontSize="8.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Border>
                            <Border Background="#27272A" CornerRadius="3" Padding="5,1">
                                <TextBlock Text="{Binding FormattedDate}" FontSize="8.5" Foreground="#A1A1AA"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="Word" Style="{StaticResource ModernBtn}" Padding="6,2" FontSize="9.5" Margin="0,0,3,0"
                                    Tag="{Binding FilePath}" Click="BtnOpenLibraryInWord_Click"/>
                            <Button Content="Convert" Style="{StaticResource ModernBtn}" Padding="6,2" FontSize="9.5"
                                    Tag="{Binding FilePath}" Click="BtnConvertLibraryItem_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Dashboard View Mode 2: Large Visual Cover Tile -->
        <DataTemplate x:Key="DashboardThumbnailTemplate">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" 
                    BorderThickness="1" CornerRadius="6" Width="170" Height="235" Margin="0,0,10,10" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cover Tile Container -->
                    <Border Grid.Row="0" Background="#18181B" CornerRadius="4" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="📄" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#71717A" Opacity="0.45"/>
                            <Border Background="{DynamicResource AccentBrushDefault}" CornerRadius="3" Padding="5,1" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                <TextBlock Text="{Binding FormatBadge}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <Border Background="#18181B" Opacity="0.85" CornerRadius="3" Padding="4,1" 
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6">
                                <TextBlock Text="{Binding PageCountDisplay}" FontSize="8" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Title -->
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="11" FontWeight="Bold" 
                               Foreground="{DynamicResource HeaderFgBrush}" Margin="0,6,0,2"
                               TextTrimming="CharacterEllipsis" MaxHeight="30" TextWrapping="Wrap"/>

                    <!-- Metadata -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding FormattedSize}" FontSize="8.5" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding FormattedDate}" FontSize="8.5" Foreground="#71717A"/>
                    </StackPanel>

                    <!-- Quick Action -->
                    <Button Grid.Row="3" Content="Open Document" Style="{StaticResource AccentBtn}" 
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Padding="4,3" FontSize="10"
                            Tag="{Binding FilePath}" Click="BtnOpenLibraryItem_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Dashboard View Mode 3: High-Density Table Details Row -->
        <DataTemplate x:Key="DashboardCompactTemplate">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" 
                    BorderThickness="0,0,0,1" Padding="10,6" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: Badge -->
                    <Border Grid.Column="0" Background="{DynamicResource AccentBrushDefault}" CornerRadius="3" 
                            Width="34" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FormatBadge}" FontSize="8" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Col 1: Title -->
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource HeaderFgBrush}" VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>

                    <!-- Col 2: Size -->
                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="9.5" Foreground="#38BDF8" 
                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"/>

                    <!-- Col 3: Date -->
                    <TextBlock Grid.Column="3" Text="{Binding FormattedDate}" FontSize="9.5" Foreground="#A1A1AA" 
                               VerticalAlignment="Center"/>

                    <!-- Col 4: Directory Path -->
                    <TextBlock Grid.Column="4" Text="{Binding DirectoryPath}" FontSize="9" Foreground="#71717A" 
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>

                    <!-- Col 5: Actions -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Open" Style="{StaticResource AccentBtn}" Padding="8,2" FontSize="9" Margin="0,0,3,0"
                                Tag="{Binding FilePath}" Click="BtnOpenLibraryItem_Click"/>
                        <Button Content="Word" Style="{StaticResource ModernBtn}" Padding="6,2" FontSize="9" Margin="0,0,3,0"
                                Tag="{Binding FilePath}" Click="BtnOpenLibraryInWord_Click"/>
                        <Button Content="Convert" Style="{StaticResource ModernBtn}" Padding="6,2" FontSize="9"
                                Tag="{Binding FilePath}" Click="BtnConvertLibraryItem_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Dedicated Top-Level App Header Bar with Native Menu + Window Caption Buttons -->
            <RowDefinition Height="*"/>    <!-- Master Content Area: Left Rail + Workspaces -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 0. DEDICATED TOP-LEVEL APP HEADER BAR                          -->
        <!-- ALWAYS VISIBLE: Logo, Menu Bar, Themes, Window Controls        -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" x:Name="TopHeaderBar" Background="{DynamicResource HeaderBgBrush}" 
                BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,0,0,1" 
                Padding="6,3" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <!-- Right: Permanent In-App Window Caption Controls (Minimize, Maximize/Restore, Close) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                    <!-- AI Copilot Flagship Button -->
                    <Button x:Name="BtnToggleAiCopilot" Content="🤖 AI Copilot" ToolTip="PSD AI Document Intelligence &amp; Copilot Suite"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="10" Height="22" Margin="0,0,8,0" Padding="8,2"
                            Style="{StaticResource ModernBtn}" Click="BtnToggleAiCopilot_Click"/>

                    <!-- Quick Theme Selector in Header -->
                    <TextBlock Text="🎨" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                    <ComboBox x:Name="CmbTheme" Width="120" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"
                              Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource WindowFgBrush}" 
                              BorderBrush="{DynamicResource BorderBrushLight}" FontSize="10" SelectionChanged="CmbTheme_SelectionChanged">
                        <ComboBoxItem Content="Fluent Dark"/>
                        <ComboBoxItem Content="Modern Light"/>
                        <ComboBoxItem Content="Glass Theme"/>
                        <ComboBoxItem Content="Word Classic Blue"/>
                        <ComboBoxItem Content="OLED Black"/>
                        <ComboBoxItem Content="Sepia Reading"/>
                        <ComboBoxItem Content="Cyberpunk Neon"/>
                        <ComboBoxItem Content="Emerald Forest"/>
                        <ComboBoxItem Content="Custom Theme"/>
                    </ComboBox>

                    <Separator Width="1" Height="16" Background="{DynamicResource BorderBrushLight}" Margin="0,0,6,0"/>

                    <!-- Permanent Caption Buttons -->
                    <Button Content="🗕" Width="28" Height="22" ToolTip="Minimize Window" 
                            Style="{StaticResource ModernBtn}" Margin="0,0,2,0" Padding="0"
                            Click="BtnWinMinimize_Click"/>
                    <Button Content="🗖" Width="28" Height="22" ToolTip="Maximize / Restore" 
                            Style="{StaticResource ModernBtn}" Margin="0,0,2,0" Padding="0"
                            Click="BtnWinMaximize_Click"/>
                    <Button Content="✕" Width="28" Height="22" ToolTip="Close Application" 
                            Background="#991B1B" Foreground="White" BorderBrush="#DC2626" 
                            Style="{StaticResource ModernBtn}" Padding="0"
                            Click="BtnWinClose_Click"/>
                </StackPanel>

                <!-- Left: Application Branding Logo & Title -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,10,0">
                    <Button x:Name="BtnHeaderToggleNav" ToolTip="Toggle Navigation Sidebar (F4)" 
                            Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Padding="7,2" Height="24"
                            Click="BtnToggleNavRail_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="☰" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sidebar" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="32" Height="22" CornerRadius="4" Background="{DynamicResource AccentBrushDefault}" Margin="0,0,6,0">
                        <TextBlock Text="PSD" FontWeight="Bold" FontSize="10.5" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PSD PDF Studio &amp; Viewer" FontWeight="Bold" FontSize="11.5" 
                               Foreground="{DynamicResource HeaderFgBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Native Windows Menu (File, Edit, View, Tools, Help) -->
                <Menu x:Name="AppMenuBar" VerticalAlignment="Center" Margin="0">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open Document (PDF / DOCX / RTF / TXT)..." InputGestureText="Ctrl+O" Click="BtnOpenFile_Click"/>
                        <MenuItem Header="New _PDF Document" InputGestureText="Ctrl+Shift+N" Click="BtnNewPdfTab_Click"/>
                        <MenuItem Header="New _Word Document (.docx)" InputGestureText="Ctrl+N" Click="BtnNewWordTab_Click"/>
                        <Separator/>
                        <MenuItem Header="_Save Incremental" InputGestureText="Ctrl+S" Click="BtnSaveFile_Click"/>
                        <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="BtnSaveAsFile_Click"/>
                        <MenuItem Header="_Print Document..." InputGestureText="Ctrl+P" Click="BtnPrint_Click"/>
                        <Separator/>
                        <MenuItem Header="Document _Properties &amp; Metadata..." InputGestureText="Ctrl+D" Click="BtnDocumentProperties_Click"/>
                        <Separator/>
                        <MenuItem Header="_Rescan Local Library" Click="BtnRescanLibrary_Click"/>
                        <Separator/>
                        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="BtnWinClose_Click"/>
                    </MenuItem>

                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Copy Text" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                        <MenuItem Header="Take Area _Snapshot to Clipboard" InputGestureText="Ctrl+Shift+C" Click="BtnToolSnapshot_Click"/>
                        <Separator/>
                        <MenuItem Header="_Find in Document..." InputGestureText="Ctrl+F" Click="BtnToggleSearch_Click"/>
                        <Separator/>
                        <MenuItem Header="_Clear Ink Sketches" Click="BtnClearInk_Click"/>
                        <MenuItem Header="_Clear Sticky Notes" Click="BtnClearNotes_Click"/>
                    </MenuItem>

                    <MenuItem Header="_View">
                        <MenuItem Header="📜  _Continuous Page Scroll" InputGestureText="Ctrl+1" Click="BtnViewContinuous_Click"/>
                        <MenuItem Header="📄  _Single Page View" InputGestureText="Ctrl+2" Click="BtnViewSinglePage_Click"/>
                        <MenuItem Header="📖  _Two-Page Book Spread" InputGestureText="Ctrl+3" Click="BtnViewTwoPage_Click"/>
                        <Separator/>
                        <MenuItem Header="🌙  _Dark Reading Mode (Invert)" InputGestureText="Ctrl+I" Click="BtnDarkModeToggle_Click"/>
                        <Separator/>
                        <MenuItem Header="⛶  _Full Screen Presentation Mode" InputGestureText="F11" Click="BtnToggleFullScreen_Click"/>
                        <MenuItem Header="◀  Toggle _Navigation Rail" InputGestureText="F4" Click="BtnToggleNavRail_Click"/>
                        <MenuItem Header="📑  Toggle _Thumbnails Panel" InputGestureText="Ctrl+T" Click="BtnToggleThumbnails_Click"/>
                        <Separator/>
                        <MenuItem Header="Zoom _In (+15%)" InputGestureText="Ctrl++" Click="BtnZoomIn_Click"/>
                        <MenuItem Header="Zoom _Out (-15%)" InputGestureText="Ctrl+-" Click="BtnZoomOut_Click"/>
                        <MenuItem Header="_Actual Size (100%)" InputGestureText="Ctrl+0" Click="BtnZoomActual_Click"/>
                        <MenuItem Header="Fit to _Width" Click="BtnFitWidth_Click"/>
                        <MenuItem Header="Fit to _Page" Click="BtnFitPage_Click"/>
                        <Separator/>
                        <MenuItem Header="Rotate _Clockwise (90°)" InputGestureText="Ctrl+R" Click="BtnRotatePage_Click"/>
                        <MenuItem Header="Rotate Counter-Clockwise (270°)" Click="BtnRotateCounterPage_Click"/>
                        <Separator/>
                        <MenuItem Header="🎨  _Themes &amp; Skins">
                            <MenuItem Header="Fluent Dark (Default)" Tag="Fluent Dark" Click="MenuTheme_Click"/>
                            <MenuItem Header="Modern Light (Paper White)" Tag="Modern Light" Click="MenuTheme_Click"/>
                            <MenuItem Header="Glass Theme (Frosted Acrylic)" Tag="Glass Theme" Click="MenuTheme_Click"/>
                            <MenuItem Header="Word Classic Blue (Office 365)" Tag="Word Classic Blue" Click="MenuTheme_Click"/>
                            <MenuItem Header="OLED Black (Pitch Black)" Tag="OLED Black" Click="MenuTheme_Click"/>
                            <MenuItem Header="Sepia Reading (Eye Care)" Tag="Sepia Reading" Click="MenuTheme_Click"/>
                            <MenuItem Header="Cyberpunk Neon" Tag="Cyberpunk Neon" Click="MenuTheme_Click"/>
                            <MenuItem Header="Emerald Forest" Tag="Emerald Forest" Click="MenuTheme_Click"/>
                            <MenuItem Header="Custom Theme..." Tag="Custom Theme" Click="MenuTheme_Click"/>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="_Tools">
                        <MenuItem Header="🤖  _PSD AI Document Copilot &amp; Intelligence..." Click="BtnToggleAiCopilot_Click"/>
                        <MenuItem Header="🔏  Enterprise _Electronic Signature &amp; Audit Trail..." Click="BtnToolSignature_Click"/>
                        <MenuItem Header="📤  _Export for AI Vector RAG Pipeline (JSON)..." Click="BtnExportRagJson_Click"/>
                        <Separator/>
                        <MenuItem Header="📝  _Microsoft Word Document Suite..." Click="NavBtnWord_Click"/>
                        <MenuItem Header="🛡️  _Security, AES-256 Encryption &amp; Redaction..." Click="BtnSecurity_Click"/>
                        <MenuItem Header="🔍  _Document Comparison (Diff Tool)..." Click="BtnDiff_Click"/>
                        <MenuItem Header="⚡  _Batch Document Automation Hub..." Click="BtnBatch_Click"/>
                        <MenuItem Header="🗜️  _PDF Compression &amp; Optimizer..." Click="BtnOptimizer_Click"/>
                        <MenuItem Header="💧  _Watermark, Headers &amp; Footers..." Click="BtnWatermark_Click"/>
                        <Separator/>
                        <MenuItem Header="📑  _Page Matrix Organizer..." Click="BtnPageOrganizer_Click"/>
                        <MenuItem Header="📷  _Camera Document Scanner..." Click="BtnScanner_Click"/>
                        <MenuItem Header="🔄  _Dual-Direction Text Converter &amp; OCR..." Click="BtnTextConverter_Click"/>
                        <Separator/>
                        <MenuItem Header="👆  _Pointer Tool" Click="MenuToolPointer_Click"/>
                        <MenuItem Header="✏️  Vector _Pen / Ink Sketch" Click="MenuToolInk_Click"/>
                        <MenuItem Header="🖍️  Text _Highlighter" Click="MenuToolHighlight_Click"/>
                        <MenuItem Header="📌  _Sticky Note Pin Tool" Click="MenuToolSticky_Click"/>
                        <MenuItem Header="📐  _Engineering Measurement (Distance / Area / Angle)" Click="MenuToolMeasure_Click"/>
                        <MenuItem Header="🧹  _Eraser Tool" Click="MenuToolEraser_Click"/>
                        <Separator/>
                        <MenuItem Header="🔏  _PKCS#7 Digital Signature Stamp" Click="MenuToolSignature_Click"/>
                        <MenuItem Header="🔊  _Read Aloud (Text-to-Speech)" Click="BtnTtsPlay_Click"/>
                    </MenuItem>

                    <MenuItem Header="_Help">
                        <MenuItem Header="_Keyboard Shortcuts" Click="BtnShortcuts_Click"/>
                        <Separator/>
                        <MenuItem Header="_About PSD PDF Studio &amp; Viewer Enterprise" Click="BtnAbout_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- 1. MASTER WORKSPACE GRID: Left Nav Rail + Dynamic View Stages   -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColNavRail" Width="190"/> <!-- Collapsible Left Rail -->
                <ColumnDefinition Width="*"/>                       <!-- Main Dynamic View Canvas -->
            </Grid.ColumnDefinitions>

            <!-- ============================================================== -->
            <!-- 1.1 LEFT NAVIGATION RAIL (Fluent 2 Design)                     -->
            <!-- ============================================================== -->
            <Border x:Name="BorderNavRail" Grid.Column="0" Background="{DynamicResource NavRailBgBrush}" 
                    BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,0,1,0" Padding="8,10">
                <DockPanel>
                    <!-- Brand / Workspace Switcher Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                        <DockPanel>
                            <TextBlock Text="WORKSPACES" FontSize="9.5" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center"/>
                            <Button Content="◀ Collapse" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    ToolTip="Collapse Navigation Sidebar (F4)" Style="{StaticResource ModernBtn}" Padding="6,2" FontSize="9.5"
                                    Click="BtnToggleNavRail_Click"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource BorderBrushDefault}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- System Telemetry Footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="2,4,2,0">
                        <Border Height="1" Background="{DynamicResource BorderBrushDefault}" Margin="0,0,0,6"/>
                        <TextBlock Text="SYSTEM CACHE &amp; ENGINE" FontSize="8.5" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,2"/>
                        <TextBlock x:Name="StatusLru" Text="LRU: 0.0 MB / 64 MB Cap" FontSize="9.5" Foreground="#38BDF8" Margin="0,0,0,1"/>
                        <TextBlock Text="DirectX WinRT: Active" FontSize="9.5" Foreground="#4ADE80"/>
                    </StackPanel>

                    <!-- Workspace Navigation Action Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="NavBtnLibrary" Style="{StaticResource NavRailBtn}" Click="NavBtnLibrary_Click">
                            <DockPanel Width="160">
                                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource AccentBrushDefault}" CornerRadius="9" Padding="6,1" Margin="4,0,0,0">
                                    <TextBlock x:Name="TxtLibraryBadge" Text="0" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="📚  Library Hub" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                        <Button x:Name="NavBtnReader" Content="📄  PDF Studio" Style="{StaticResource NavRailBtn}" Click="NavBtnReader_Click"/>
                        <Button x:Name="NavBtnWord" Content="📝  Word Suite (.docx)" Style="{StaticResource NavRailBtn}" Foreground="#38BDF8" Click="NavBtnWord_Click"/>
                        <Button x:Name="NavBtnAiCopilot" Content="🤖  AI Copilot Suite" Style="{StaticResource NavRailBtn}" Foreground="#38BDF8" FontWeight="Bold" Click="BtnToggleAiCopilot_Click"/>
                        <Button x:Name="NavBtnESign" Content="🔏  e-Sign &amp; Audit" Style="{StaticResource NavRailBtn}" Foreground="#4ADE80" Click="BtnToolSignature_Click"/>
                        <Button x:Name="NavBtnSecurity" Content="🛡️  Security &amp; Redact" Style="{StaticResource NavRailBtn}" Click="BtnSecurity_Click"/>
                        <Button x:Name="NavBtnDiff" Content="🔍  Compare Docs" Style="{StaticResource NavRailBtn}" Click="BtnDiff_Click"/>
                        <Button x:Name="NavBtnBatch" Content="⚡  Batch Automation" Style="{StaticResource NavRailBtn}" Click="BtnBatch_Click"/>
                        <Button x:Name="NavBtnOptimizer" Content="🗜️  PDF Optimizer" Style="{StaticResource NavRailBtn}" Click="BtnOptimizer_Click"/>
                        <Button x:Name="NavBtnOrganizer" Content="📑  Page Organizer" Style="{StaticResource NavRailBtn}" Click="NavBtnOrganizer_Click"/>
                        <Button x:Name="NavBtnScanner" Content="📷  Camera &amp; Scan" Style="{StaticResource NavRailBtn}" Click="NavBtnScanner_Click"/>
                        <Button x:Name="NavBtnConverter" Content="🔄  Text &amp; Markdown" Style="{StaticResource NavRailBtn}" Click="NavBtnConverter_Click"/>

                        <Border Height="1" Background="{DynamicResource BorderBrushDefault}" Margin="0,10,0,10"/>

                        <TextBlock Text="CREATE / IMPORT" FontSize="8.5" FontWeight="Bold" Foreground="#71717A" Margin="6,0,0,4"/>
                        <Button Content="📝  New Word Doc" Style="{StaticResource ModernBtn}" Margin="0,2" Click="BtnNewWordTab_Click"/>
                        <Button Content="➕  New Blank PDF" Style="{StaticResource ModernBtn}" Margin="0,2" Click="BtnNewPdfTab_Click"/>
                        <Button Content="📂  Open File..." Style="{StaticResource AccentBtn}" Margin="0,2" Click="BtnOpenFile_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================================================== -->
            <!-- 1.2 MAIN DYNAMIC VIEW CONTAINER                               -->
            <!-- ============================================================== -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ColAiCopilotPanel" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Floating Show Rail Tab (Appears pinned to edge when rail is collapsed) -->
                <Button x:Name="BtnFloatingShowRail" Grid.Column="0" Width="auto" Height="28" Padding="8,2"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0"
                        Panel.ZIndex="1000" ToolTip="Expand Navigation Sidebar (F4)"
                        Style="{StaticResource AccentBtn}" Visibility="Collapsed"
                        Click="BtnToggleNavRail_Click" FontWeight="Bold" FontSize="11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▶" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sidebar (F4)" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Grid Grid.Column="0">
                
                <!-- ========================================================== -->
                <!-- VIEW A: LOCAL PDF & DOCUMENT LIBRARY DASHBOARD             -->
                <!-- ========================================================== -->
                <Grid x:Name="ViewLibrary" Visibility="Visible" Background="{DynamicResource WindowBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header & Quick Actions -->
                        <RowDefinition Height="Auto"/> <!-- 1: KPI Metric Cards -->
                        <RowDefinition Height="Auto"/> <!-- 2: Filter, Sort & View Mode Ribbon -->
                        <RowDefinition Height="*"/>    <!-- 3: Scrollable Document View Canvas -->
                        <RowDefinition Height="26"/>   <!-- 4: Bottom Library Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- Library Header -->
                    <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" 
                            BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="14,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Device Library &amp; Document Dashboard" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HeaderFgBrush}"/>
                                <TextBlock x:Name="TxtScanStatus" Text="Scanning device for PDFs, Word documents, RTF and Markdown..." 
                                           FontSize="10" Foreground="#A1A1AA" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="🔄 Rescan All" Style="{StaticResource ModernBtn}" Margin="0,0,4,0" Click="BtnRescanLibrary_Click"/>
                                <Button Content="📝 New Word" Style="{StaticResource ModernBtn}" Margin="0,0,4,0" Click="BtnNewWordTab_Click"/>
                                <Button Content="➕ New PDF" Style="{StaticResource ModernBtn}" Margin="0,0,4,0" Click="BtnNewPdfTab_Click"/>
                                <Button Content="📂 Open Doc..." Style="{StaticResource AccentBtn}" Click="BtnOpenFile_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- KPI Metric Cards Grid -->
                    <Border Grid.Row="1" Padding="14,6,14,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="DOCUMENTS INDEXED" FontSize="8.5" FontWeight="Bold" Foreground="#71717A"/>
                                    <TextBlock x:Name="TxtKpiTotalPdfs" Text="0 Documents" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,1,0,0"/>
                                    <TextBlock Text="PDF, Word, Text &amp; PSD files" FontSize="8.5" Foreground="#71717A"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="2,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="INDEXED STORAGE" FontSize="8.5" FontWeight="Bold" Foreground="#71717A"/>
                                    <TextBlock x:Name="TxtKpiTotalSize" Text="0.0 MB" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource HeaderFgBrush}" Margin="0,1,0,0"/>
                                    <TextBlock Text="Local device footprint" FontSize="8.5" Foreground="#71717A"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="2,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="WORD SUITE PIPELINE" FontSize="8.5" FontWeight="Bold" Foreground="#71717A"/>
                                    <TextBlock Text="Full DOCX / RTF / PDF" FontSize="14" FontWeight="Bold" Foreground="#4ADE80" Margin="0,1,0,0"/>
                                    <TextBlock Text="OpenXML &amp; Vector native engine" FontSize="8.5" Foreground="#71717A"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="DIRECTX VECTOR CACHE" FontSize="8.5" FontWeight="Bold" Foreground="#71717A"/>
                                    <TextBlock Text="256 MB LRU Cap" FontSize="14" FontWeight="Bold" Foreground="#A78BFA" Margin="0,1,0,0"/>
                                    <TextBlock Text="Multi-threaded GPU pipeline" FontSize="8.5" Foreground="#71717A"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Filter, Sort & Multiple View Modes Ribbon -->
                    <Border Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,1,0,1" Padding="14,5" Margin="0,4,0,4">
                        <DockPanel LastChildFill="True">
                            <!-- Right: Multiple View Mode Switcher -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="View Mode:" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="BtnDashboardGrid" Content="⊞ Grid" ToolTip="Multi-column Responsive Card Grid" 
                                        Style="{StaticResource AccentBtn}" Padding="8,3" Margin="0,0,2,0" FontSize="10.5" Click="BtnDashboardGrid_Click"/>
                                <Button x:Name="BtnDashboardThumbnails" Content="🖼️ Cover Tile" ToolTip="Visual Cover Gallery View" 
                                        Style="{StaticResource ModernBtn}" Padding="8,3" Margin="0,0,2,0" FontSize="10.5" Click="BtnDashboardThumbnails_Click"/>
                                <Button x:Name="BtnDashboardCompact" Content="☰ Details List" ToolTip="High-Density Table View" 
                                        Style="{StaticResource ModernBtn}" Padding="8,3" FontSize="10.5" Click="BtnDashboardCompact_Click"/>
                            </StackPanel>

                            <!-- Left: Filter & Sort Controls -->
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Search Input Box -->
                                <Border Background="#1F1F23" CornerRadius="4" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Padding="6,2" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="10"/>
                                        <TextBox x:Name="TxtLibrarySearch" Width="130" Background="Transparent" Foreground="White" 
                                                 BorderThickness="0" FontSize="10.5" VerticalAlignment="Center"
                                                 TextChanged="TxtLibrarySearch_TextChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- File Format Filter -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Format:" FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbFilterType" Width="110" Height="22" SelectionChanged="CmbFilterType_SelectionChanged"
                                              Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource WindowFgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" FontSize="10">
                                        <ComboBoxItem Content="All Formats" IsSelected="True"/>
                                        <ComboBoxItem Content="PDF Documents"/>
                                        <ComboBoxItem Content="Word Documents"/>
                                        <ComboBoxItem Content="Text &amp; Markdown"/>
                                        <ComboBoxItem Content="Photoshop PSD"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Date Filter -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Date:" FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbFilterDate" Width="95" Height="22" SelectionChanged="CmbFilterDate_SelectionChanged"
                                              Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource WindowFgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" FontSize="10">
                                        <ComboBoxItem Content="All Time" IsSelected="True"/>
                                        <ComboBoxItem Content="Today"/>
                                        <ComboBoxItem Content="This Week"/>
                                        <ComboBoxItem Content="This Month"/>
                                        <ComboBoxItem Content="Past Year"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Size Filter -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Size:" FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbFilterSize" Width="100" Height="22" SelectionChanged="CmbFilterSize_SelectionChanged"
                                              Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource WindowFgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" FontSize="10">
                                        <ComboBoxItem Content="All Sizes" IsSelected="True"/>
                                        <ComboBoxItem Content="&lt; 1 MB (Small)"/>
                                        <ComboBoxItem Content="1 - 10 MB (Med)"/>
                                        <ComboBoxItem Content="&gt; 10 MB (Large)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Sort Order -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Sort:" FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="CmbSortOrder" Width="145" Height="22" SelectionChanged="CmbSortOrder_SelectionChanged"
                                              Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource WindowFgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" FontSize="10">
                                        <ComboBoxItem Content="Date Modified (Newest)" IsSelected="True"/>
                                        <ComboBoxItem Content="Date Modified (Oldest)"/>
                                        <ComboBoxItem Content="Name (A → Z)"/>
                                        <ComboBoxItem Content="Name (Z → A)"/>
                                        <ComboBoxItem Content="Size (Largest First)"/>
                                        <ComboBoxItem Content="Size (Smallest First)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Reset Filters Button -->
                                <Button x:Name="BtnResetFilters" Content="✕ Clear" ToolTip="Reset All Filters and Search" 
                                        Style="{StaticResource ModernBtn}" Padding="6,2" FontSize="9.5" Click="BtnResetFilters_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- Scrollable Document Cards List with View Mode Switching & Context Menu -->
                    <ScrollViewer Grid.Row="3" Padding="14,4,14,8" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="LibraryList" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource DashboardGridTemplate}"
                                 ItemsPanel="{StaticResource WrapPanelHost}"
                                 MouseDoubleClick="LibraryList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="LibraryContextMenu" Background="{DynamicResource SubmenuBgBrush}" Foreground="{DynamicResource SubmenuFgBrush}">
                                    <MenuItem Header="📄  Open in PSD PDF Studio" Click="LibMenuOpenReader_Click"/>
                                    <MenuItem Header="📝  Open in Word Suite (.docx)" Click="LibMenuOpenWord_Click"/>
                                    <MenuItem Header="📑  Page Organizer &amp; Extraction" Click="LibMenuOrganize_Click"/>
                                    <MenuItem Header="🔄  Convert Document to Text / Markdown" Click="LibMenuConvert_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📂  Show in Windows File Explorer" Click="LibMenuShowInExplorer_Click"/>
                                    <MenuItem Header="📋  Copy File Path to Clipboard" Click="LibMenuCopyPath_Click"/>
                                    <Separator/>
                                    <MenuItem Header="ℹ️  Document Properties &amp; Metadata" Click="LibMenuProperties_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Library Footer Status Bar -->
                    <Border Grid.Row="4" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,1,0,0" Padding="14,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLibraryFooterCount" Text="0 documents in library" FontSize="9.5" Foreground="#A1A1AA"/>
                            <TextBlock Text="PSD Universal Hub: Double-click or Right-click any file to open, edit, organize, or convert" 
                                       HorizontalAlignment="Right" FontSize="9.5" Foreground="#71717A"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ========================================================== -->
                <!-- VIEW B: HIGH-PERFORMANCE PDF STUDIO & READER VIEWPORT     -->
                <!-- ========================================================== -->
                <Grid x:Name="ViewReader" Visibility="Collapsed" Background="{DynamicResource CanvasBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Document Tabs Bar -->
                        <RowDefinition Height="Auto"/> <!-- Main Ribbon Toolbar -->
                        <RowDefinition Height="Auto"/> <!-- In-Document Search Bar -->
                        <RowDefinition Height="*"/>    <!-- Main Viewport + Thumbnails Sidebar -->
                        <RowDefinition Height="24"/>   <!-- Viewport Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- Document Tabs Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="6,3,6,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,2">
                                <Button x:Name="BtnNewTab" Content="➕ New Tab" Width="80" Height="22" 
                                        Style="{StaticResource ModernBtn}" Margin="0,0,4,0" Click="BtnNewTab_Click"/>
                            </StackPanel>

                            <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="TabList_SelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#27272A" CornerRadius="4,4,0,0" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1,1,1,0" 
                                                Padding="10,4,6,4" Margin="0,0,3,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource HeaderFgBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Content="✕" Width="13" Height="13" Margin="6,0,0,0" Background="Transparent" 
                                                        Foreground="#A1A1AA" BorderThickness="0" Tag="{Binding}" Click="BtnCloseTab_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Main Ribbon Toolbar -->
                    <Border Grid.Row="1" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="6,4">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- View Toggles: Nav Rail, Thumbnails, Full Screen -->
                            <Button x:Name="BtnToggleNavRail" Content="◫ Hide Sidebar (F4)" ToolTip="Toggle Navigation Sidebar (F4)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnToggleNavRail_Click"/>
                            <Button x:Name="BtnToggleThumbnails" Content="📑 Thumbs" ToolTip="Toggle Thumbnails Sidebar (Ctrl+T)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnToggleThumbnails_Click"/>
                            <Button x:Name="BtnFullScreen" Content="⛶ Presentation (F11)" ToolTip="Dedicated Full Screen View (F11)" Style="{StaticResource AccentBtn}" Margin="1" Click="BtnToggleFullScreen_Click"/>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Page View Modes: Continuous Scroll, Single Page, Two-Page Spread -->
                            <Button x:Name="BtnViewContinuous" Content="📜 Continuous" ToolTip="Continuous Multi-Page Vertical Scroll (Ctrl+1)" Style="{StaticResource AccentBtn}" Margin="1" Click="BtnViewContinuous_Click"/>
                            <Button x:Name="BtnViewSinglePage" Content="📄 Single" ToolTip="Single Page View (Ctrl+2)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnViewSinglePage_Click"/>
                            <Button x:Name="BtnViewTwoPage" Content="📖 Two-Page" ToolTip="Two-Page Book Spread (Ctrl+3)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnViewTwoPage_Click"/>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Navigation Steppers & Quick Jump -->
                            <Button x:Name="BtnFirstPage" Content="⏮" ToolTip="First Page" Width="26" Padding="2" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnFirstPage_Click"/>
                            <Button x:Name="BtnPrevPage" Content="◀ Prev" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnPrevPage_Click"/>
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtJumpPage" Text="1" Width="28" Background="Transparent" Foreground="{DynamicResource WindowFgBrush}" BorderThickness="0" 
                                             TextAlignment="Center" FontWeight="Bold" FontSize="10.5" KeyDown="TxtJumpPage_KeyDown"/>
                                    <TextBlock x:Name="TxtNavPageIndicator" Text=" / 1" FontSize="10.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnNextPage" Content="Next ▶" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnNextPage_Click"/>
                            <Button x:Name="BtnLastPage" Content="⏭" ToolTip="Last Page" Width="26" Padding="2" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnLastPage_Click"/>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Zoom Controls -->
                            <Button x:Name="BtnZoomOut" Content="➖" Width="26" Height="22" Padding="2" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnZoomOut_Click"/>
                            <TextBlock x:Name="TxtZoomLevel" Text="100%" Width="40" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WindowFgBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                            <Button x:Name="BtnZoomIn" Content="➕" Width="26" Height="22" Padding="2" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnZoomIn_Click"/>
                            <Button x:Name="BtnFitWidth" Content="Fit Width" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnFitWidth_Click"/>
                            <Button x:Name="BtnRotatePage" Content="Rotate 90°" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnRotatePage_Click"/>
                            <Button x:Name="BtnDarkModeToggle" Content="🌙 Dark Mode" ToolTip="Toggle Night / Invert Reading Mode (Ctrl+I)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnDarkModeToggle_Click"/>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Annotation Tools Suite -->
                            <Button x:Name="BtnToolPointer" Content="👆 Pointer" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnToolSnapshot" Content="📷 Snapshot" ToolTip="Capture Area Snapshot to Clipboard (Ctrl+Shift+C)" Style="{StaticResource ModernBtn}" Foreground="#38BDF8" Margin="1" Click="BtnToolSnapshot_Click"/>

                            <!-- Pen Sketch & Palette -->
                            <Button x:Name="BtnToolInk" Content="✏️ Sketch" Style="{StaticResource ModernBtn}" Foreground="#F87171" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnPdfPenColor" ToolTip="Sketch Pen Color Palette" Style="{StaticResource ModernBtn}" Margin="0,1,1,1" Padding="4,2" Click="BtnPdfPenColor_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="IndicatorPenColor" Width="10" Height="10" CornerRadius="2" Background="#DC2626"/>
                                    <TextBlock Text=" ▾" FontSize="8" Margin="2,0,0,0" Foreground="#A1A1AA"/>
                                </StackPanel>
                            </Button>
                            <Popup x:Name="PopupPdfPenColor" PlacementTarget="{Binding ElementName=BtnPdfPenColor}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource SubmenuBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="6" Width="135" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="PEN COLOR" FontSize="8.5" FontWeight="Bold" Foreground="#71717A" Margin="2,0,0,4"/>
                                        <UniformGrid Columns="5" Rows="2">
                                            <Button Width="20" Height="20" Margin="1" Background="#DC2626" BorderThickness="0" Focusable="False" ToolTip="Red" Click="PdfPenColorChip_Click" Tag="#DC2626"/>
                                            <Button Width="20" Height="20" Margin="1" Background="#0284C7" BorderThickness="0" Focusable="False" ToolTip="Blue" Click="PdfPenColorChip_Click" Tag="#0284C7"/>
                                            <Button Width="20" Height="20" Margin="1" Background="#16A34A" BorderThickness="0" Focusable="False" ToolTip="Green" Click="PdfPenColorChip_Click" Tag="#16A34A"/>
                                            <Button Width="20" Height="20" Margin="1" Background="#9333EA" BorderThickness="0" Focusable="False" ToolTip="Purple" Click="PdfPenColorChip_Click" Tag="#9333EA"/>
                                            <Button Width="20" Height="20" Margin="1" Background="#EA580C" BorderThickness="0" Focusable="False" ToolTip="Orange" Click="PdfPenColorChip_Click" Tag="#EA580C"/>
                                            <Button Width="20" Height="20" Margin="1" Background="#CA8A04" BorderThickness="0" Focusable="False" ToolTip="Gold" Click="PdfPenColorChip_Click" Tag="#CA8A04"/>
                                            <Button Width="20" Height="20" Margin="1" Background="#DB2777" BorderThickness="0" Focusable="False" ToolTip="Pink" Click="PdfPenColorChip_Click" Tag="#DB2777"/>
                                            <Button Width="20" Height="20" Margin="1" Background="#0D9488" BorderThickness="0" Focusable="False" ToolTip="Teal" Click="PdfPenColorChip_Click" Tag="#0D9488"/>
                                            <Button Width="20" Height="20" Margin="1" Background="#18181B" BorderBrush="#52525B" BorderThickness="1" Focusable="False" ToolTip="Black" Click="PdfPenColorChip_Click" Tag="#18181B"/>
                                            <Button Width="20" Height="20" Margin="1" Background="#FFFFFF" BorderBrush="#52525B" BorderThickness="1" Focusable="False" ToolTip="White" Click="PdfPenColorChip_Click" Tag="#FFFFFF"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <ComboBox x:Name="CmbPdfPenWidth" Width="68" Height="22" VerticalAlignment="Center" Margin="1"
                                      Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource WindowFgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" FontSize="10"
                                      ToolTip="Pen Stroke Thickness" SelectionChanged="CmbPdfPenWidth_SelectionChanged">
                                <ComboBoxItem Content="1.5 pt" IsSelected="True"/>
                                <ComboBoxItem Content="3.0 pt"/>
                                <ComboBoxItem Content="5.0 pt"/>
                                <ComboBoxItem Content="10.0 pt"/>
                            </ComboBox>

                            <Button x:Name="BtnToolHighlight" Content="🖍️ Highlight" Style="{StaticResource ModernBtn}" Foreground="#FACC15" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnToolSticky" Content="📌 Note" Style="{StaticResource ModernBtn}" Foreground="#FB923C" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnToolMeasure" Content="📐 Measure" Style="{StaticResource ModernBtn}" Foreground="#38BDF8" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnToolSignature" Content="🔏 Sign &amp; Audit" ToolTip="Enterprise Electronic Signature Studio" Style="{StaticResource ModernBtn}" Foreground="#60A5FA" Margin="1" Click="BtnToolSignature_Click"/>
                            <Button x:Name="BtnToolbarCopilot" Content="🤖 Copilot" ToolTip="PSD AI Document Copilot" Style="{StaticResource ModernBtn}" Foreground="#38BDF8" Margin="1" Click="BtnToggleAiCopilot_Click"/>
                            <Button x:Name="BtnToolbarOrganize" Content="📑 Organize" ToolTip="Page Matrix Organizer" Style="{StaticResource ModernBtn}" Foreground="#34D399" Margin="1" Click="BtnPageOrganizer_Click"/>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Read Aloud Speech Synthesizer -->
                            <Button x:Name="BtnTtsPlay" Content="🔊 Read" ToolTip="Read Page Aloud" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnTtsPlay_Click"/>
                            <Button x:Name="BtnTtsPause" Content="⏸" ToolTip="Pause Speech" Style="{StaticResource ModernBtn}" Width="26" Height="22" Padding="2" Margin="1" Click="BtnTtsPause_Click"/>
                            <Button x:Name="BtnTtsStop" Content="⏹" ToolTip="Stop Speech" Style="{StaticResource ModernBtn}" Width="26" Height="22" Padding="2" Margin="1" Click="BtnTtsStop_Click"/>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Enterprise Operations -->
                            <Button Content="🛡️ Security" ToolTip="AES-256 &amp; Redaction" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnSecurity_Click"/>
                            <Button Content="🗜️ Optimize" ToolTip="Compress PDF" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnOptimizer_Click"/>
                            <Button Content="💧 Watermark" ToolTip="Watermark &amp; Headers" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnWatermark_Click"/>
                            <Button Content="ℹ️ Info" ToolTip="Document Properties &amp; Metadata (Ctrl+D)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnDocumentProperties_Click"/>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Actions & Search -->
                            <Button x:Name="BtnSaveFile" Content="💾 Save" Style="{StaticResource AccentBtn}" Margin="1" Click="BtnSaveFile_Click"/>
                            <Button x:Name="BtnToggleSearch" Content="🔍 Find" Style="{StaticResource ModernBtn}" Margin="2,1,1,1" Click="BtnToggleSearch_Click"/>
                            <Button Content="📝 Edit in Word Suite" Style="{StaticResource ModernBtn}" Margin="2,1,1,1" Click="NavBtnWord_Click"/>
                        </WrapPanel>
                    </Border>

                    <!-- Search Panel -->
                    <Border x:Name="SearchPanel" Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="12,5" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Search Document:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#A1A1AA" FontSize="10.5"/>
                            <TextBox x:Name="TxtSearchQuery" Width="200" Background="#121214" Foreground="White" BorderBrush="{DynamicResource BorderBrushLight}" Padding="5,2" KeyUp="TxtSearchQuery_KeyUp"/>
                            <Button x:Name="BtnFindPrev" Content="◀ Prev" Style="{StaticResource ModernBtn}" Margin="4,0,2,0" Click="BtnFindPrev_Click"/>
                            <Button x:Name="BtnFindNext" Content="Next ▶" Style="{StaticResource ModernBtn}" Margin="2,0,4,0" Click="BtnFindNext_Click"/>
                            <TextBlock x:Name="TxtMatchCount" Text="0 matches" VerticalAlignment="Center" Margin="6,0" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10.5"/>
                            <Button x:Name="BtnCloseSearch" Content="Close" Style="{StaticResource ModernBtn}" Margin="4,0" Click="BtnCloseSearch_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Core Viewport & Thumbnails Filmstrip -->
                    <Grid Grid.Row="3" Background="{DynamicResource CanvasBgBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColThumbnails" Width="160"/> <!-- Thumbnails Sidebar -->
                            <ColumnDefinition Width="*"/>                         <!-- Main Canvas Viewport -->
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnails Sidebar -->
                        <Border x:Name="BorderThumbnails" Grid.Column="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <TextBlock Text="PAGE THUMBNAILS" DockPanel.Dock="Top" FontSize="9" FontWeight="Bold" Foreground="#71717A" Margin="10,8,0,4"/>
                                <ListBox x:Name="ThumbnailList" Background="Transparent" BorderThickness="0" Margin="2" SelectionChanged="ThumbnailList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" Width="130" Height="175" Margin="3" CornerRadius="4" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding RenderedImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Foreground="#E4E4E7" FontWeight="Bold"/>
                                                    <Border Background="#18181B" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}" FontSize="8.5" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Main Canvas Viewport -->
                        <ScrollViewer x:Name="MainScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                                      Background="{DynamicResource CanvasBgBrush}" Padding="16"
                                      ScrollChanged="MainScrollViewer_ScrollChanged"
                                      PreviewMouseDown="MainScrollViewer_PreviewMouseDown"
                                      PreviewMouseMove="MainScrollViewer_PreviewMouseMove"
                                      PreviewMouseUp="MainScrollViewer_PreviewMouseUp">
                            <ScrollViewer.ContextMenu>
                                <ContextMenu x:Name="PdfContextMenu">
                                    <MenuItem Header="📋  Copy Text" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                                    <MenuItem Header="📷  Take Area Snapshot" InputGestureText="Ctrl+Shift+C" Click="BtnToolSnapshot_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📜  Continuous Page Scroll" InputGestureText="Ctrl+1" Click="BtnViewContinuous_Click"/>
                                    <MenuItem Header="📄  Single Page View" InputGestureText="Ctrl+2" Click="BtnViewSinglePage_Click"/>
                                    <MenuItem Header="📖  Two-Page Book Spread" InputGestureText="Ctrl+3" Click="BtnViewTwoPage_Click"/>
                                    <MenuItem Header="⛶  Presentation Full Screen" InputGestureText="F11" Click="BtnToggleFullScreen_Click"/>
                                    <Separator/>
                                    <MenuItem Header="👆  Pointer / Hand Tool" Click="BtnToolPointer_Click"/>
                                    <MenuItem Header="✏️  Ink Sketch Pen" Click="BtnToolInk_Click"/>
