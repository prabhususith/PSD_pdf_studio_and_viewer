                            <Popup x:Name="PopupWordSymbol" PlacementTarget="{Binding ElementName=BtnWordInsertSymbol}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="8" Width="180">
                                    <StackPanel>
                                        <TextBlock Text="SPECIAL SYMBOLS &amp; ICONS" FontSize="8" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,4"/>
                                        <UniformGrid Columns="6" Rows="4">
                                            <Button Content="©" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="©"/>
                                            <Button Content="®" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="®"/>
                                            <Button Content="™" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="™"/>
                                            <Button Content="€" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="€"/>
                                            <Button Content="£" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="£"/>
                                            <Button Content="¥" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="¥"/>
                                            <Button Content="•" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="•"/>
                                            <Button Content="—" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="—"/>
                                            <Button Content="–" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="–"/>
                                            <Button Content="→" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="→"/>
                                            <Button Content="←" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="←"/>
                                            <Button Content="↔" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="↔"/>
                                            <Button Content="✓" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="#4ADE80" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="✓"/>
                                            <Button Content="✕" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="#F87171" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="✕"/>
                                            <Button Content="★" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="#FACC15" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="★"/>
                                            <Button Content="♥" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="#F472B6" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="♥"/>
                                            <Button Content="°" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="°"/>
                                            <Button Content="±" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="±"/>
                                            <Button Content="×" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="×"/>
                                            <Button Content="÷" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="÷"/>
                                            <Button Content="∞" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="∞"/>
                                            <Button Content="≈" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="≈"/>
                                            <Button Content="√" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="√"/>
                                            <Button Content="⚠️" Width="24" Height="22" Margin="1" Background="#27272A" Foreground="White" BorderThickness="0" Focusable="False" Click="SymbolChip_Click" Tag="⚠️"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Page Setup (Margins) -->
                            <TextBlock Text="Margins:" VerticalAlignment="Center" Foreground="#71717A" FontSize="9.5" Margin="2,0"/>
                            <Button Content="Normal" ToolTip="1 inch Margins" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnWordMarginsNormal_Click"/>
                            <Button Content="Narrow" ToolTip="0.5 inch Margins" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnWordMarginsNarrow_Click"/>
                            <Button Content="Wide" ToolTip="1.5 inch Margins" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnWordMarginsWide_Click"/>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Find & Replace -->
                            <Button x:Name="BtnWordToggleFindReplace" Content="🔍 Replace" ToolTip="Find &amp; Replace (Ctrl+H)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnWordToggleFindReplace_Click"/>

                            <Separator Width="1" Height="18" Margin="4,0"/>

                            <!-- Document Templates Dropdown -->
                            <Button x:Name="BtnWordTemplates" Content="📋 Templates ▾" ToolTip="Quick Starter Enterprise Templates" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnWordTemplates_Click"/>
                            <Popup x:Name="PopupWordTemplates" PlacementTarget="{Binding ElementName=BtnWordTemplates}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="6" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="DOCUMENT TEMPLATES" FontSize="8" FontWeight="Bold" Foreground="#71717A" Margin="4,0,0,4"/>
                                        <Button Content="📊 Project Charter" Style="{StaticResource ModernBtn}" HorizontalContentAlignment="Left" Padding="6,4" Margin="1" Focusable="False" Click="WordTemplateChip_Click" Tag="Project Charter"/>
                                        <Button Content="👤 Modern Resume / CV" Style="{StaticResource ModernBtn}" HorizontalContentAlignment="Left" Padding="6,4" Margin="1" Focusable="False" Click="WordTemplateChip_Click" Tag="Resume"/>
                                        <Button Content="💼 Business Proposal" Style="{StaticResource ModernBtn}" HorizontalContentAlignment="Left" Padding="6,4" Margin="1" Focusable="False" Click="WordTemplateChip_Click" Tag="Business Proposal"/>
                                        <Button Content="🔒 Mutual NDA Agreement" Style="{StaticResource ModernBtn}" HorizontalContentAlignment="Left" Padding="6,4" Margin="1" Focusable="False" Click="WordTemplateChip_Click" Tag="NDA"/>
                                        <Button Content="📝 Meeting Minutes" Style="{StaticResource ModernBtn}" HorizontalContentAlignment="Left" Padding="6,4" Margin="1" Focusable="False" Click="WordTemplateChip_Click" Tag="Meeting Minutes"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Button x:Name="BtnWordDetailedStats" Content="📊 Audit &amp; Readability" ToolTip="Detailed Document Word Count &amp; Readability Analysis" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnWordDetailedStats_Click"/>
                        </WrapPanel>
                    </Border>

                    <!-- Word Find & Replace Docked Panel -->
                    <Border x:Name="WordFindReplacePanel" Grid.Row="1" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="12,6" Visibility="Collapsed">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Find:" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                <TextBox x:Name="TxtWordFind" Width="140" Background="#18181B" Foreground="White" BorderBrush="{DynamicResource BorderBrushLight}" Padding="5,2" Margin="0,0,10,0"/>

                                <TextBlock Text="Replace:" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                <TextBox x:Name="TxtWordReplace" Width="140" Background="#18181B" Foreground="White" BorderBrush="{DynamicResource BorderBrushLight}" Padding="5,2" Margin="0,0,10,0"/>

                                <CheckBox x:Name="ChkWordMatchCase" Content="Match Case" Foreground="{DynamicResource WindowFgBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="10.5"/>

                                <Button Content="Find Next" Style="{StaticResource ModernBtn}" Margin="2,0" Click="BtnWordFindNext_Click"/>
                                <Button Content="Replace" Style="{StaticResource ModernBtn}" Margin="2,0" Click="BtnWordReplace_Click"/>
                                <Button Content="Replace All" Style="{StaticResource AccentBtn}" Margin="2,0" Click="BtnWordReplaceAll_Click"/>
                                <TextBlock x:Name="TxtWordFindCount" Text="" Foreground="#38BDF8" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10.5" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Button Content="✕" DockPanel.Dock="Right" Width="20" Height="20" Style="{StaticResource ModernBtn}" Padding="0" Click="BtnWordCloseFind_Click"/>
                        </DockPanel>
                    </Border>

                    <!-- Centered A4 Page Editing Canvas -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                                  Background="{DynamicResource CanvasBgBrush}" Padding="20">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="816" MinHeight="1056" Background="#FFFFFF" CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.5" Color="#000000"/>
                                </Border.Effect>

                                <RichTextBox x:Name="RtbWordEditor" Background="Transparent" Foreground="#1E293B" 
                                             BorderThickness="0" Margin="48" AcceptsReturn="True" AcceptsTab="True"
                                             SpellCheck.IsEnabled="True" FontSize="13" FontFamily="Segoe UI"
                                             SelectionChanged="RtbWordEditor_SelectionChanged"
                                             TextChanged="RtbWordEditor_TextChanged">
                                    <RichTextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="✂️  Cut" Command="ApplicationCommands.Cut"/>
                                            <MenuItem Header="📋  Copy" Command="ApplicationCommands.Copy"/>
                                            <MenuItem Header="📄  Paste" Command="ApplicationCommands.Paste"/>
                                            <Separator/>
                                            <MenuItem Header="🔤  Font Dialog..." Click="BtnWordFont_Click"/>
                                            <MenuItem Header="📏  Align Left" InputGestureText="Ctrl+L" Click="BtnWordAlignLeft_Click"/>
                                            <MenuItem Header="📏  Align Center" InputGestureText="Ctrl+E" Click="BtnWordAlignCenter_Click"/>
                                            <MenuItem Header="📏  Align Right" InputGestureText="Ctrl+R" Click="BtnWordAlignRight_Click"/>
                                            <MenuItem Header="📏  Justify" InputGestureText="Ctrl+J" Click="BtnWordAlignJustify_Click"/>
                                            <Separator/>
                                            <MenuItem Header="🖼️  Insert Picture..." Click="BtnWordInsertImage_Click"/>
                                            <MenuItem Header="⊞  Insert Table (3x3)..." Click="BtnWordInsertTable_Click"/>
                                            <MenuItem Header="―  Insert Horizontal Line" Click="BtnWordInsertHr_Click"/>
                                            <MenuItem Header="📅  Insert Date &amp; Time" Click="BtnWordInsertDate_Click"/>
                                            <Separator/>
                                            <MenuItem Header="💾  Save Document" InputGestureText="Ctrl+S" Click="BtnWordSave_Click"/>
                                            <MenuItem Header="🖨️  Print Document..." InputGestureText="Ctrl+P" Click="BtnWordPrint_Click"/>
                                        </ContextMenu>
                                    </RichTextBox.ContextMenu>
                                </RichTextBox>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Word Suite Telemetry & Statistics Status Bar -->
                    <Border Grid.Row="3" Background="{DynamicResource StatusBarBgBrush}" Padding="12,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtWordStats" Text="Words: 0 | Characters: 0 | Paragraphs: 1 | Reading Time: 1 min" 
                                       Foreground="{DynamicResource StatusBarFgBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Zoom: 100%" Foreground="{DynamicResource StatusBarFgBrush}" FontSize="9.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderWordZoom" Width="90" Minimum="50" Maximum="200" Value="100" 
                                        VerticalAlignment="Center" ValueChanged="SliderWordZoom_ValueChanged"/>
                                <TextBlock Text="Microsoft Word Compatible Suite" Foreground="{DynamicResource StatusBarFgBrush}" FontSize="9.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ========================================================== -->
                <!-- VIEW D: DEDICATED FULL-SCREEN PDF PRESENTATION MODE        -->
                <!-- Borderless, Clean Canvas with Floating Bottom Nav Pill     -->
                <!-- ========================================================== -->
                <Grid x:Name="ViewPdfFullScreen" Visibility="Collapsed" Background="#000000">
                    <!-- Centered Presentation Image -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#000000">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <Image x:Name="ImgFullScreenPage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- Floating Semi-Transparent Bottom Navigation Pill -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                            Background="#DD18181B" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="20" Padding="14,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.8" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⏮ Prev" Style="{StaticResource ModernBtn}" Margin="2,0" Click="BtnFsPrev_Click"/>
                            <Border Background="#27272A" CornerRadius="4" Padding="8,3" Margin="4,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtFsPageIndicator" Text="Page 1 of 1" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                            </Border>
                            <Button Content="Next ⏭" Style="{StaticResource ModernBtn}" Margin="2,0" Click="BtnFsNext_Click"/>
                            
                            <Separator Width="1" Height="16" Background="#3F3F46" Margin="6,0"/>

                            <Button Content="➖ Zoom" Style="{StaticResource ModernBtn}" Margin="2,0" Click="BtnFsZoomOut_Click"/>
                            <Button Content="Zoom ➕" Style="{StaticResource ModernBtn}" Margin="2,0" Click="BtnFsZoomIn_Click"/>
                            <Button Content="Fit Width" Style="{StaticResource ModernBtn}" Margin="2,0" Click="BtnFsFitWidth_Click"/>

                            <Separator Width="1" Height="16" Background="#3F3F46" Margin="6,0"/>

                            <Button Content="✕ Exit Full Screen (Esc)" Style="{StaticResource AccentBtn}" Margin="2,0" Click="BtnExitFullScreen_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
