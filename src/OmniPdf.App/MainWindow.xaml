<Window x:Class="OmniPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omni PDF Studio - High-Performance Vector PDF Engine &amp; Studio Suite"
        Height="630" Width="1140" MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#0F0F12" Foreground="#ECECEF"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#52525B"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#52525B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Rail Button Style -->
        <Style x:Key="NavRailBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Native Menu Styles -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#ECECEF"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECECEF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Native Windows Menu Bar -->
            <RowDefinition Height="*"/>    <!-- Main Application Canvas -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 0. NATIVE WINDOWS MENU BAR (File, Edit, View, Tools, Help)     -->
        <!-- ============================================================== -->
        <Menu Grid.Row="0" x:Name="AppMenuBar" Background="#18181B" Foreground="#ECECEF" 
              BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="6,2">
            
            <MenuItem Header="_File">
                <MenuItem Header="_Open PDF Document..." InputGestureText="Ctrl+O" Click="BtnOpenFile_Click"/>
                <MenuItem Header="_New Blank Document" InputGestureText="Ctrl+N" Click="BtnNewTab_Click"/>
                <MenuItem Header="_Save Incremental" InputGestureText="Ctrl+S" Click="BtnSaveFile_Click"/>
                <Separator/>
                <MenuItem Header="_Rescan Device Library" Click="BtnRescanLibrary_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="BtnWinClose_Click"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Find in Document..." InputGestureText="Ctrl+F" Click="BtnToggleSearch_Click"/>
                <Separator/>
                <MenuItem Header="_Clear Ink Sketches" Click="BtnClearInk_Click"/>
                <MenuItem Header="_Clear Sticky Notes" Click="BtnClearNotes_Click"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="⛶  _Full Screen Mode" InputGestureText="F11" Click="BtnToggleFullScreen_Click"/>
                <MenuItem Header="◀  Toggle _Navigation Rail" InputGestureText="F4" Click="BtnToggleNavRail_Click"/>
                <MenuItem Header="📑  Toggle _Thumbnails Panel" InputGestureText="Ctrl+T" Click="BtnToggleThumbnails_Click"/>
                <Separator/>
                <MenuItem Header="Zoom _In (+15%)" InputGestureText="Ctrl++" Click="BtnZoomIn_Click"/>
                <MenuItem Header="Zoom _Out (-15%)" InputGestureText="Ctrl+-" Click="BtnZoomOut_Click"/>
                <MenuItem Header="_Actual Size (100%)" Click="BtnZoomActual_Click"/>
                <MenuItem Header="Fit to _Width" Click="BtnFitWidth_Click"/>
                <MenuItem Header="Fit to _Page" Click="BtnFitPage_Click"/>
                <Separator/>
                <MenuItem Header="Rotate _Clockwise (90°)" InputGestureText="Ctrl+R" Click="BtnRotatePage_Click"/>
                <MenuItem Header="Rotate Counter-Clockwise (270°)" Click="BtnRotateCounterPage_Click"/>
                <Separator/>
                <MenuItem Header="🎨  _Themes &amp; Skins">
                    <MenuItem Header="Fluent Dark (Default)" Tag="Fluent Dark" Click="MenuTheme_Click"/>
                    <MenuItem Header="Modern Light (Paper White)" Tag="Modern Light" Click="MenuTheme_Click"/>
                    <MenuItem Header="OLED Black (Pitch Black)" Tag="OLED Black" Click="MenuTheme_Click"/>
                    <MenuItem Header="Sepia Reading (Eye Care)" Tag="Sepia Reading" Click="MenuTheme_Click"/>
                    <MenuItem Header="Windows 11 Mica" Tag="Windows Mica" Click="MenuTheme_Click"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="📑  _Page Matrix Organizer..." Click="BtnPageOrganizer_Click"/>
                <MenuItem Header="📷  _Camera Document Scanner..." Click="BtnScanner_Click"/>
                <MenuItem Header="🔄  _Dual-Direction Text Converter &amp; OCR..." Click="BtnTextConverter_Click"/>
                <Separator/>
                <MenuItem Header="👆  _Pointer Tool" Click="MenuToolPointer_Click"/>
                <MenuItem Header="✏️  Vector _Pen / Ink Sketch" Click="MenuToolInk_Click"/>
                <MenuItem Header="🖍️  Text _Highlighter" Click="MenuToolHighlight_Click"/>
                <MenuItem Header="📌  _Sticky Note Pin Tool" Click="MenuToolSticky_Click"/>
                <MenuItem Header="🧹  _Eraser Tool" Click="MenuToolEraser_Click"/>
                <Separator/>
                <MenuItem Header="🔏  _PKCS#7 Digital Signature Stamp" Click="MenuToolSignature_Click"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" Click="BtnShortcuts_Click"/>
                <Separator/>
                <MenuItem Header="_About Omni PDF Studio Enterprise" Click="BtnAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ============================================================== -->
        <!-- MASTER MAIN GRID: Left Rail + Dynamic Views                     -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColNavRail" Width="200"/> <!-- Collapsible Left Rail -->
                <ColumnDefinition Width="*"/>                       <!-- Main Dynamic Content Stage -->
            </Grid.ColumnDefinitions>

            <!-- ============================================================== -->
            <!-- 1. LEFT NAVIGATION RAIL (Modern Windows 11 Fluent 2 Design)     -->
            <!-- ============================================================== -->
            <Border x:Name="BorderNavRail" Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,1,0" Padding="10,12">
                <DockPanel>
                    <!-- Brand / Logo Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,2,14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="6" Background="#0284C7" Margin="0,0,8,0">
                                    <TextBlock Text="P" FontWeight="Bold" FontSize="18" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="OMNI PDF" FontWeight="Bold" FontSize="14" Foreground="#F4F4F5"/>
                                    <TextBlock Text="STUDIO PRO" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="◀" Width="24" Height="24" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    ToolTip="Collapse Rail (F4)" Style="{StaticResource ModernBtn}" Padding="0" Click="BtnToggleNavRail_Click"/>
                        </DockPanel>
                        <Border Height="1" Background="#27272A" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- System Telemetry Footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="2,6,2,0">
                        <Border Height="1" Background="#27272A" Margin="0,0,0,8"/>
                        <TextBlock Text="CACHE &amp; ENGINE" FontSize="9" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,3"/>
                        <TextBlock x:Name="StatusLru" Text="LRU: 0.0 MB / 64 MB Cap" FontSize="10" Foreground="#38BDF8" Margin="0,0,0,2"/>
                        <TextBlock Text="DirectX WinRT Vector: Active" FontSize="10" Foreground="#4ADE80"/>
                    </StackPanel>

                    <!-- Primary Nav Action Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="WORKSPACES" FontSize="9" FontWeight="Bold" Foreground="#71717A" Margin="6,0,0,6"/>
                        
                        <Button x:Name="NavBtnLibrary" Style="{StaticResource NavRailBtn}" Click="NavBtnLibrary_Click">
                            <DockPanel Width="160">
                                <TextBlock Text="📚  Library Hub" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#0284C7" CornerRadius="10" Padding="6,1">
                                    <TextBlock x:Name="TxtLibraryBadge" Text="0" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </DockPanel>
                        </Button>

                        <Button x:Name="NavBtnReader" Content="📄  Document Reader" Style="{StaticResource NavRailBtn}" Click="NavBtnReader_Click"/>
                        <Button x:Name="NavBtnOrganizer" Content="📑  Page Organizer" Style="{StaticResource NavRailBtn}" Click="NavBtnOrganizer_Click"/>
                        <Button x:Name="NavBtnScanner" Content="📷  Camera &amp; Scan" Style="{StaticResource NavRailBtn}" Click="NavBtnScanner_Click"/>
                        <Button x:Name="NavBtnConverter" Content="🔄  Text &amp; Markdown" Style="{StaticResource NavRailBtn}" Click="NavBtnConverter_Click"/>

                        <Border Height="1" Background="#27272A" Margin="0,12,0,12"/>

                        <TextBlock Text="QUICK ACTIONS" FontSize="9" FontWeight="Bold" Foreground="#71717A" Margin="6,0,0,6"/>
                        <Button x:Name="BtnNavOpenPdf" Content="📂  Open PDF File..." Style="{StaticResource ModernBtn}" Margin="0,2" Click="BtnOpenFile_Click"/>
                        <Button x:Name="BtnNavNewPdf" Content="➕  Blank Document" Style="{StaticResource ModernBtn}" Margin="0,2" Click="BtnNewTab_Click"/>
                        <Button x:Name="BtnNavRescan" Content="🔄  Rescan Device" Style="{StaticResource ModernBtn}" Margin="0,2" Click="BtnRescanLibrary_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================================================== -->
            <!-- 2. MAIN DYNAMIC CONTENT CONTAINER                             -->
            <!-- ============================================================== -->
            <Grid Grid.Column="1">
                
                <!-- VIEW A: LOCAL PDF LIBRARY / DASHBOARD (Auto-scanned Device Hub) -->
                <Grid x:Name="ViewLibrary" Visibility="Visible" Background="#0F0F12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Library Header & Search Bar -->
                        <RowDefinition Height="Auto"/> <!-- KPI Metric Cards -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Document Cards Grid -->
                        <RowDefinition Height="26"/>   <!-- Bottom Library Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- Library Header & Search Bar -->
                    <Border Grid.Row="0" Background="#141417" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="18,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Device PDF Library &amp; Document Hub" FontSize="18" FontWeight="Bold" Foreground="#F4F4F5"/>
                                <TextBlock x:Name="TxtScanStatus" Text="Scanning local folders across Documents, Desktop, Downloads &amp; Workspaces..." 
                                           FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Live Search Input -->
                                <Border Background="#1F1F23" CornerRadius="5" BorderBrush="#3F3F46" BorderThickness="1" Padding="6,3" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtLibrarySearch" Width="150" Background="Transparent" Foreground="White" 
                                                 BorderThickness="0" FontSize="11" VerticalAlignment="Center"
                                                 TextChanged="TxtLibrarySearch_TextChanged"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="🔄 Rescan" Style="{StaticResource ModernBtn}" Margin="0,0,6,0" Click="BtnRescanLibrary_Click"/>
                                <Button Content="📂 Open PDF" Style="{StaticResource AccentBtn}" Margin="0,0,10,0" Click="BtnOpenFile_Click"/>

                                <Separator Width="1" Height="20" Background="#3F3F46" Margin="0,0,10,0"/>

                                <!-- Window Caption Controls -->
                                <Button Content="🗕" Width="28" Height="24" ToolTip="Minimize" Style="{StaticResource ModernBtn}" Margin="0,0,2,0" Click="BtnWinMinimize_Click"/>
                                <Button Content="🗖" Width="28" Height="24" ToolTip="Maximize / Restore" Style="{StaticResource ModernBtn}" Margin="0,0,2,0" Click="BtnWinMaximize_Click"/>
                                <Button Content="✕" Width="28" Height="24" ToolTip="Close Application" Background="#991B1B" Foreground="White" BorderBrush="#DC2626" Style="{StaticResource ModernBtn}" Click="BtnWinClose_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- KPI Metric Cards Grid -->
                    <Border Grid.Row="1" Padding="18,12,18,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Metric 1: Total PDFs -->
                            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="PDFS DETECTED" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                                    <TextBlock x:Name="TxtKpiTotalPdfs" Text="0 Documents" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                                    <TextBlock Text="Auto-indexed from local drives" FontSize="10" Foreground="#52525B" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 2: Total Size -->
                            <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="INDEXED FOOTPRINT" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                                    <TextBlock x:Name="TxtKpiTotalSize" Text="0.0 MB" FontSize="18" FontWeight="Bold" Foreground="#F4F4F5" Margin="0,3,0,0"/>
                                    <TextBlock Text="Zero disk duplication overhead" FontSize="10" Foreground="#52525B" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 3: Vector Engine -->
                            <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="VECTOR ACCELERATION" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                                    <TextBlock Text="DirectX WinRT" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" Margin="0,3,0,0"/>
                                    <TextBlock Text="Hardware rasterizer enabled" FontSize="10" Foreground="#52525B" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 4: LRU Cache -->
                            <Border Grid.Column="3" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="RAM CACHE CAP" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                                    <TextBlock Text="64 MB Strict" FontSize="18" FontWeight="Bold" Foreground="#A78BFA" Margin="0,3,0,0"/>
                                    <TextBlock Text="Sub-128MB RAM ceiling" FontSize="10" Foreground="#52525B" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Scrollable Document Cards List -->
                    <ScrollViewer Grid.Row="2" Padding="18,6,18,12" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="LibraryList" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                        <DockPanel LastChildFill="True">
                                            <!-- Actions Row -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="Open in Reader" Style="{StaticResource AccentBtn}" Padding="12,5" Margin="0,0,5,0"
                                                        Tag="{Binding FilePath}" Click="BtnOpenLibraryItem_Click"/>
                                                <Button Content="Organize" Style="{StaticResource ModernBtn}" Padding="8,5" Margin="0,0,5,0"
                                                        Tag="{Binding FilePath}" Click="BtnOrganizeLibraryItem_Click"/>
                                                <Button Content="Convert / OCR" Style="{StaticResource ModernBtn}" Padding="8,5"
                                                        Tag="{Binding FilePath}" Click="BtnConvertLibraryItem_Click"/>
                                            </StackPanel>

                                            <!-- Document Thumbnail Badge & Info -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="38" Height="44" Background="#991B1B" CornerRadius="5" Margin="0,0,12,0">
                                                    <TextBlock Text="PDF" FontWeight="Bold" FontSize="12" Foreground="White" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#F4F4F5"/>
                                                    <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="#71717A" Margin="0,1,0,3" 
                                                               MaxWidth="440" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#27272A" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                                                            <TextBlock Text="{Binding FormattedSize}" FontSize="9" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                                        </Border>
                                                        <Border Background="#27272A" CornerRadius="3" Padding="5,1">
                                                            <TextBlock Text="{Binding FormattedDate, StringFormat='Modified: {0}'}" FontSize="9" Foreground="#A1A1AA"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Library Footer Status Bar -->
                    <Border Grid.Row="3" Background="#141417" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="18,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLibraryFooterCount" Text="0 documents in library" FontSize="10" Foreground="#A1A1AA"/>
                            <TextBlock Text="Click 'Open in Reader' to launch instant hardware-accelerated preview" 
                                       HorizontalAlignment="Right" FontSize="10" Foreground="#71717A"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- VIEW B: HIGH-PERFORMANCE PDF READER & EDITOR VIEWPORT -->
                <Grid x:Name="ViewReader" Visibility="Collapsed" Background="#121214">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Document Tabs Bar -->
                        <RowDefinition Height="Auto"/> <!-- Main Ribbon Toolbar -->
                        <RowDefinition Height="Auto"/> <!-- In-Document Search Bar -->
                        <RowDefinition Height="*"/>    <!-- Main Viewport + Thumbnails Sidebar -->
                        <RowDefinition Height="26"/>   <!-- Viewport Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- Document Tabs Bar -->
                    <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="8,4,8,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,3">
                                <Button x:Name="BtnNewTab" Content="➕ New Tab" Width="84" Height="24" 
                                        Style="{StaticResource ModernBtn}" Margin="0,0,6,0" Click="BtnNewTab_Click"/>
                                <Separator Width="1" Height="18" Background="#3F3F46" Margin="0,0,6,0"/>
                                <Button Content="🗕" Width="26" Height="24" ToolTip="Minimize" Style="{StaticResource ModernBtn}" Margin="0,0,2,0" Click="BtnWinMinimize_Click"/>
                                <Button Content="🗖" Width="26" Height="24" ToolTip="Maximize / Restore" Style="{StaticResource ModernBtn}" Margin="0,0,2,0" Click="BtnWinMaximize_Click"/>
                                <Button Content="✕" Width="26" Height="24" ToolTip="Close Application" Background="#991B1B" Foreground="White" BorderBrush="#DC2626" Style="{StaticResource ModernBtn}" Click="BtnWinClose_Click"/>
                            </StackPanel>

                            <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="TabList_SelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#27272A" CornerRadius="5,5,0,0" BorderBrush="#3F3F46" BorderThickness="1,1,1,0" 
                                                Padding="12,5,8,5" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Foreground="#F4F4F5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Content="✕" Width="14" Height="14" Margin="8,0,0,0" Background="Transparent" 
                                                        Foreground="#A1A1AA" BorderThickness="0" Tag="{Binding}" Click="BtnCloseTab_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Main Ribbon Toolbar -->
                    <Border Grid.Row="1" Background="#1E1E24" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="8,6">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- View Toggles: Nav Rail, Thumbnails, Full Screen -->
                            <Button x:Name="BtnToggleNavRail" Content="◀ Rail" ToolTip="Toggle Navigation Rail (F4)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnToggleNavRail_Click"/>
                            <Button x:Name="BtnToggleThumbnails" Content="📑 Thumbs" ToolTip="Toggle Thumbnails Sidebar (Ctrl+T)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnToggleThumbnails_Click"/>
                            <Button x:Name="BtnFullScreen" Content="⛶ Full Screen" ToolTip="Toggle Full Screen (F11)" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnToggleFullScreen_Click"/>

                            <Separator Width="1" Height="20" Background="#3F3F46" Margin="6,0"/>

                            <!-- Navigation Steppers -->
                            <Button x:Name="BtnPrevPage" Content="◀ Prev" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnPrevPage_Click"/>
                            <Border Background="#27272A" CornerRadius="4" Padding="6,3" Margin="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtNavPageIndicator" Text="Page 1 / 1" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Border>
                            <Button x:Name="BtnNextPage" Content="Next ▶" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnNextPage_Click"/>

                            <Separator Width="1" Height="20" Background="#3F3F46" Margin="6,0"/>

                            <!-- Zoom Controls -->
                            <Button x:Name="BtnZoomOut" Content="➖" Width="26" Height="24" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnZoomOut_Click"/>
                            <TextBlock x:Name="TxtZoomLevel" Text="100%" Width="40" TextAlignment="Center" VerticalAlignment="Center" Foreground="#F4F4F5" FontSize="11" FontWeight="SemiBold"/>
                            <Button x:Name="BtnZoomIn" Content="➕" Width="26" Height="24" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnZoomIn_Click"/>
                            <Button x:Name="BtnFitWidth" Content="Fit Width" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnFitWidth_Click"/>
                            <Button x:Name="BtnRotatePage" Content="Rotate 90°" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnRotatePage_Click"/>

                            <Separator Width="1" Height="20" Background="#3F3F46" Margin="6,0"/>

                            <!-- Annotation Tools Suite -->
                            <Button x:Name="BtnToolPointer" Content="👆 Pointer" Style="{StaticResource ModernBtn}" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnToolInk" Content="✏️ Sketch Pen" Style="{StaticResource ModernBtn}" Foreground="#F87171" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnToolHighlight" Content="🖍️ Highlight" Style="{StaticResource ModernBtn}" Foreground="#FACC15" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnToolSticky" Content="📌 Sticky Note" Style="{StaticResource ModernBtn}" Foreground="#FB923C" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnToolEraser" Content="🧹 Eraser" Style="{StaticResource ModernBtn}" Foreground="#A1A1AA" Margin="1" Click="BtnTool_Click"/>
                            <Button x:Name="BtnToolSignature" Content="🔏 Sign" Style="{StaticResource ModernBtn}" Foreground="#60A5FA" Margin="1" Click="BtnTool_Click"/>

                            <Separator Width="1" Height="20" Background="#3F3F46" Margin="6,0"/>

                            <!-- Actions & Search -->
                            <Button x:Name="BtnSaveFile" Content="💾 Save" Style="{StaticResource AccentBtn}" Margin="1" Click="BtnSaveFile_Click"/>
                            <Button x:Name="BtnToggleSearch" Content="🔍 Find" Style="{StaticResource ModernBtn}" Margin="4,1,1,1" Click="BtnToggleSearch_Click"/>

                            <Separator Width="1" Height="20" Background="#3F3F46" Margin="6,0"/>

                            <!-- Theme Selector Dropdown (Prominent on Toolbar) -->
                            <TextBlock Text="🎨 Theme:" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbTheme" Width="120" Height="24" VerticalAlignment="Center" Margin="1"
                                      Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46"
                                      SelectionChanged="CmbTheme_SelectionChanged">
                                <ComboBoxItem Content="Fluent Dark"/>
                                <ComboBoxItem Content="Modern Light"/>
                                <ComboBoxItem Content="OLED Black"/>
                                <ComboBoxItem Content="Sepia Reading"/>
                                <ComboBoxItem Content="Windows Mica"/>
                            </ComboBox>
                        </WrapPanel>
                    </Border>

                    <!-- Search Panel -->
                    <Border x:Name="SearchPanel" Grid.Row="2" Background="#1F1F24" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="14,6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Search Document:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A1A1AA" FontSize="11"/>
                            <TextBox x:Name="TxtSearchQuery" Width="220" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="6,3" KeyUp="TxtSearchQuery_KeyUp"/>
                            <Button x:Name="BtnFindNext" Content="Next Match" Style="{StaticResource ModernBtn}" Margin="6,0,4,0" Click="BtnFindNext_Click"/>
                            <TextBlock x:Name="TxtMatchCount" Text="0 matches" VerticalAlignment="Center" Margin="6,0" Foreground="#A1A1AA" FontSize="11"/>
                            <Button x:Name="BtnCloseSearch" Content="Close" Style="{StaticResource ModernBtn}" Margin="6,0" Click="BtnCloseSearch_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Core Viewport & Thumbnails Filmstrip -->
                    <Grid Grid.Row="3" Background="#0F0F12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColThumbnails" Width="170"/> <!-- Thumbnails Sidebar -->
                            <ColumnDefinition Width="*"/>                         <!-- Main Canvas Viewport -->
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnails Sidebar -->
                        <Border x:Name="BorderThumbnails" Grid.Column="0" Background="#141417" BorderBrush="#27272A" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <TextBlock Text="PAGE THUMBNAILS" DockPanel.Dock="Top" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="12,10,0,6"/>
                                <ListBox x:Name="ThumbnailList" Background="Transparent" BorderThickness="0" Margin="3" SelectionChanged="ThumbnailList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" Width="140" Height="190" Margin="4" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding RenderedImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" Foreground="#E4E4E7" FontWeight="Bold"/>
                                                    <Border Background="#18181B" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" CornerRadius="3" Padding="5,1">
                                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Main Canvas Viewport -->
                        <ScrollViewer x:Name="MainScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                                      Background="#09090B" Padding="20">
                            <Grid x:Name="CanvasContainer" HorizontalAlignment="Center">
                                <!-- Page Card Frame -->
                                <Border x:Name="PageBorder" Background="#FFFFFF" CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
                                    </Border.Effect>

                                    <Grid x:Name="PageContentGrid" MouseLeftButtonDown="PageContentGrid_MouseLeftButtonDown">
                                        <!-- High-DPI Real Rendered PDF Page -->
                                        <Image x:Name="ImgPageRender" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Content Stream Text (Fallback/Search overlay) -->
                                        <TextBox x:Name="TxtPageContent" Margin="48" Background="Transparent" Foreground="#18181B" 
                                                 BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" FontFamily="Georgia"/>

                                        <!-- Interactive Ink & Vector Overlay Canvas -->
                                        <InkCanvas x:Name="PageInkCanvas" Background="Transparent" IsHitTestVisible="False"/>

                                        <!-- Interactive Sticky Notes Overlay Canvas -->
                                        <Canvas x:Name="NotesCanvas" Background="Transparent" IsHitTestVisible="True"/>

                                        <!-- PKCS#7 Digital Signature Badge -->
                                        <Border x:Name="SignatureBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                                Margin="20" Background="#EFF6FF" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="5" Padding="10,6" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✓ PKCS#7 Verified Digital Signature" FontWeight="Bold" Foreground="#0284C7" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Reader Status Bar -->
                    <Border x:Name="ReaderStatusBar" Grid.Row="4" Background="#0284C7" Padding="14,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StatusPage" Text="Page 1 of 1" Foreground="White" FontSize="10" Margin="0,0,14,0" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusDimensions" Text="Dimensions: 612 x 792 pt" Foreground="#E0F2FE" FontSize="10" Margin="0,0,14,0"/>
                            <TextBlock x:Name="StatusToolIndicator" Text="Tool: Pointer" Foreground="#E0F2FE" FontSize="10" Margin="0,0,14,0"/>
                            <TextBlock Text="DirectX Hardware Acceleration: ACTIVE" Foreground="#E0F2FE" FontSize="10" Margin="0,0,14,0"/>
                            <TextBlock Text="Omni PDF Studio Desktop Engine" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#E0F2FE" FontSize="10"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
