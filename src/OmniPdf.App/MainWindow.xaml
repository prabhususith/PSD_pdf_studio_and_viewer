                                    <StackPanel>
                                        <TextBlock Text="👋 Welcome to PSD AI Copilot" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <TextBlock Text="I can analyze active PDF documents or Word files entirely offline. Click an action above or type any question below to inspect clauses, deadlines, figures, or risks." 
                                                   TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource WindowFgBrush}" LineHeight="15"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Ask Input Box -->
                        <Border Grid.Row="3" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,1,0,0" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtAiPrompt" Grid.Column="0" Background="#18181B" Foreground="White" BorderBrush="{DynamicResource BorderBrushLight}" 
                                         Padding="8,5" FontSize="10.5" KeyDown="TxtAiPrompt_KeyDown"
                                         ToolTip="Ask anything about this document..."/>
                                <Button Grid.Column="1" Content="Ask AI ➔" Style="{StaticResource AccentBtn}" Margin="6,0,0,0" Padding="10,4" FontSize="10.5" Click="BtnAiAsk_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
