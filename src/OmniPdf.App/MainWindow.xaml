<Window x:Class="OmniPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omni PDF Studio - High-Performance Vector PDF Engine &amp; Studio Suite"
        Height="900" Width="1440" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12" Foreground="#ECECEF"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#52525B"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#52525B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Rail Button Style -->
        <Style x:Key="NavRailBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/> <!-- Left Navigation Rail -->
            <ColumnDefinition Width="*"/>   <!-- Main Dynamic Content Stage -->
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- 1. LEFT NAVIGATION RAIL (Modern Windows 11 Fluent 2 Design)     -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,1,0" Padding="12,16">
            <DockPanel>
                <!-- Brand / Logo Header -->
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#0284C7" Margin="0,0,10,0">
                            <TextBlock Text="P" FontWeight="Bold" FontSize="20" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OMNI PDF" FontWeight="Bold" FontSize="16" Foreground="#F4F4F5"/>
                            <TextBlock Text="STUDIO PRO v1.0" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="#27272A" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- System Telemetry & Themes Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0">
                    <Border Height="1" Background="#27272A" Margin="0,0,0,12"/>
                    <TextBlock Text="THEME" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbTheme" Margin="0,0,0,12" Background="#27272A" Foreground="White" 
                              BorderBrush="#3F3F46" Padding="8,4" SelectionChanged="CmbTheme_SelectionChanged">
                        <ComboBoxItem Content="Fluent Dark"/>
                        <ComboBoxItem Content="OLED Black"/>
                        <ComboBoxItem Content="Sepia Reading"/>
                        <ComboBoxItem Content="Windows Mica"/>
                    </ComboBox>

                    <TextBlock Text="CACHE &amp; ENGINE" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatusLru" Text="LRU: 0.0 MB / 64 MB Cap" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,2"/>
                    <TextBlock Text="DirectX WinRT Vector: Active" FontSize="11" Foreground="#4ADE80"/>
                </StackPanel>

                <!-- Primary Nav Action Items -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WORKSPACES" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="8,0,0,8"/>
                    
                    <Button x:Name="NavBtnLibrary" Style="{StaticResource NavRailBtn}" Click="NavBtnLibrary_Click">
                        <DockPanel Width="190">
                            <TextBlock Text="📚  Library Hub" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#0284C7" CornerRadius="10" Padding="8,2">
                                <TextBlock x:Name="TxtLibraryBadge" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </DockPanel>
                    </Button>

                    <Button x:Name="NavBtnReader" Content="📄  Document Reader" Style="{StaticResource NavRailBtn}" Click="NavBtnReader_Click"/>
                    <Button x:Name="NavBtnOrganizer" Content="📑  Page Organizer" Style="{StaticResource NavRailBtn}" Click="NavBtnOrganizer_Click"/>
                    <Button x:Name="NavBtnScanner" Content="📷  Camera &amp; Scan" Style="{StaticResource NavRailBtn}" Click="NavBtnScanner_Click"/>
                    <Button x:Name="NavBtnConverter" Content="🔄  Text &amp; Markdown" Style="{StaticResource NavRailBtn}" Click="NavBtnConverter_Click"/>

                    <Border Height="1" Background="#27272A" Margin="0,16,0,16"/>

                    <TextBlock Text="QUICK ACTIONS" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="8,0,0,8"/>
                    <Button x:Name="BtnNavOpenPdf" Content="📂  Open PDF File..." Style="{StaticResource ModernBtn}" Margin="0,3" Click="BtnOpenFile_Click"/>
                    <Button x:Name="BtnNavNewPdf" Content="➕  New Blank Document" Style="{StaticResource ModernBtn}" Margin="0,3" Click="BtnNewTab_Click"/>
                    <Button x:Name="BtnNavRescan" Content="🔄  Rescan Device" Style="{StaticResource ModernBtn}" Margin="0,3" Click="BtnRescanLibrary_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. MAIN DYNAMIC CONTENT CONTAINER                             -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1">
            
            <!-- VIEW A: LOCAL PDF LIBRARY / DASHBOARD (Auto-scanned Device Hub) -->
            <Grid x:Name="ViewLibrary" Visibility="Visible" Background="#0F0F12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Library Header & Search Bar -->
                    <RowDefinition Height="Auto"/> <!-- KPI Metric Cards -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Document Cards Grid -->
                    <RowDefinition Height="28"/>   <!-- Bottom Library Status Bar -->
                </Grid.RowDefinitions>

                <!-- Library Header & Search Bar -->
                <Border Grid.Row="0" Background="#141417" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="24,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Device PDF Library &amp; Document Hub" FontSize="20" FontWeight="Bold" Foreground="#F4F4F5"/>
                            <TextBlock x:Name="TxtScanStatus" Text="Scanning local folders across Documents, Desktop, Downloads &amp; Workspaces..." 
                                       FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Live Search Input -->
                            <Border Background="#1F1F23" CornerRadius="6" BorderBrush="#3F3F46" BorderThickness="1" Padding="8,4" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtLibrarySearch" Width="240" Background="Transparent" Foreground="White" 
                                             BorderThickness="0" FontSize="12" VerticalAlignment="Center"
                                             TextChanged="TxtLibrarySearch_TextChanged"/>
                                </StackPanel>
                            </Border>

                            <Button Content="🔄 Rescan Device" Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Click="BtnRescanLibrary_Click"/>
                            <Button Content="📂 Open External PDF" Style="{StaticResource AccentBtn}" Click="BtnOpenFile_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- KPI Metric Cards Grid -->
                <Border Grid.Row="1" Padding="24,16,24,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Metric 1: Total PDFs -->
                        <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PDFS DETECTED" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
                                <TextBlock x:Name="TxtKpiTotalPdfs" Text="0 Documents" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                <TextBlock Text="Auto-indexed from local drives" FontSize="11" Foreground="#52525B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 2: Total Size -->
                        <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="INDEXED FOOTPRINT" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
                                <TextBlock x:Name="TxtKpiTotalSize" Text="0.0 MB" FontSize="20" FontWeight="Bold" Foreground="#F4F4F5" Margin="0,4,0,0"/>
                                <TextBlock Text="Zero disk duplication overhead" FontSize="11" Foreground="#52525B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 3: Vector Engine -->
                        <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="VECTOR ACCELERATION" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
                                <TextBlock Text="DirectX WinRT" FontSize="20" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,0"/>
                                <TextBlock Text="Hardware rasterizer enabled" FontSize="11" Foreground="#52525B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 4: LRU Cache -->
                        <Border Grid.Column="3" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RAM CACHE CAP" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
                                <TextBlock Text="64 MB Strict" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" Margin="0,4,0,0"/>
                                <TextBlock Text="Redmi Note 4 sub-128MB ceiling" FontSize="11" Foreground="#52525B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Scrollable Document Cards List -->
                <ScrollViewer Grid.Row="2" Padding="24,8,24,16" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="LibraryList" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                    <DockPanel LastChildFill="True">
                                        <!-- Actions Row -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button Content="Open in Reader" Style="{StaticResource AccentBtn}" Padding="14,6" Margin="0,0,6,0"
                                                    Tag="{Binding FilePath}" Click="BtnOpenLibraryItem_Click"/>
                                            <Button Content="Organize" Style="{StaticResource ModernBtn}" Padding="10,6" Margin="0,0,6,0"
                                                    Tag="{Binding FilePath}" Click="BtnOrganizeLibraryItem_Click"/>
                                            <Button Content="Convert / OCR" Style="{StaticResource ModernBtn}" Padding="10,6"
                                                    Tag="{Binding FilePath}" Click="BtnConvertLibraryItem_Click"/>
                                        </StackPanel>

                                        <!-- Document Thumbnail Badge & Info -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="44" Height="50" Background="#991B1B" CornerRadius="6" Margin="0,0,16,0">
                                                <TextBlock Text="PDF" FontWeight="Bold" FontSize="14" Foreground="White" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F4F4F5"/>
                                                <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="#71717A" Margin="0,2,0,4" 
                                                           MaxWidth="500" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#27272A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                                    </Border>
                                                    <Border Background="#27272A" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding FormattedDate, StringFormat='Modified: {0}'}" FontSize="10" Foreground="#A1A1AA"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Library Footer Status Bar -->
                <Border Grid.Row="3" Background="#141417" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="24,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLibraryFooterCount" Text="0 documents in library" FontSize="11" Foreground="#A1A1AA"/>
                        <TextBlock Text="Double-click or click 'Open in Reader' to launch instant hardware-accelerated preview" 
                                   HorizontalAlignment="Right" FontSize="11" Foreground="#71717A"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- VIEW B: HIGH-PERFORMANCE PDF READER & EDITOR VIEWPORT -->
            <Grid x:Name="ViewReader" Visibility="Collapsed" Background="#121214">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Document Tabs Bar -->
                    <RowDefinition Height="Auto"/> <!-- Main Ribbon Toolbar -->
                    <RowDefinition Height="Auto"/> <!-- In-Document Search Bar -->
                    <RowDefinition Height="*"/>    <!-- Main Viewport + Thumbnails Sidebar -->
                    <RowDefinition Height="28"/>   <!-- Viewport Status Bar -->
                </Grid.RowDefinitions>

                <!-- Document Tabs Bar -->
                <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="10,6,10,0">
                    <DockPanel>
                        <Button x:Name="BtnNewTab" Content="➕ New Tab" Width="90" Height="26" DockPanel.Dock="Right" 
                                Style="{StaticResource ModernBtn}" Margin="6,0,0,4" Click="BtnNewTab_Click"/>

                        <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="TabList_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#27272A" CornerRadius="6,6,0,0" BorderBrush="#3F3F46" BorderThickness="1,1,1,0" 
                                            Padding="14,6,10,6" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Content="✕" Width="16" Height="16" Margin="10,0,0,0" Background="Transparent" 
                                                    Foreground="#A1A1AA" BorderThickness="0" Tag="{Binding}" Click="BtnCloseTab_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Main Ribbon Toolbar -->
                <Border Grid.Row="1" Background="#1E1E24" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="12,8">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Navigation Group -->
                        <Button x:Name="BtnPrevPage" Content="◀ Prev" Style="{StaticResource ModernBtn}" Margin="2" Click="BtnPrevPage_Click"/>
                        <Border Background="#27272A" CornerRadius="4" Padding="8,4" Margin="2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNavPageIndicator" Text="Page 1 / 1" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Border>
                        <Button x:Name="BtnNextPage" Content="Next ▶" Style="{StaticResource ModernBtn}" Margin="2" Click="BtnNextPage_Click"/>

                        <Separator Width="1" Height="22" Background="#3F3F46" Margin="8,0"/>

                        <!-- Zoom Controls -->
                        <Button x:Name="BtnZoomOut" Content="➖" Width="30" Height="28" Style="{StaticResource ModernBtn}" Margin="2" Click="BtnZoomOut_Click"/>
                        <TextBlock x:Name="TxtZoomLevel" Text="100%" Width="45" TextAlignment="Center" VerticalAlignment="Center" Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold"/>
                        <Button x:Name="BtnZoomIn" Content="➕" Width="30" Height="28" Style="{StaticResource ModernBtn}" Margin="2" Click="BtnZoomIn_Click"/>
                        <Button x:Name="BtnFitWidth" Content="Fit Width" Style="{StaticResource ModernBtn}" Margin="2" Click="BtnFitWidth_Click"/>
                        <Button x:Name="BtnRotatePage" Content="Rotate 90°" Style="{StaticResource ModernBtn}" Margin="2" Click="BtnRotatePage_Click"/>

                        <Separator Width="1" Height="22" Background="#3F3F46" Margin="8,0"/>

                        <!-- Annotation Markup Suite -->
                        <Button x:Name="BtnToolPointer" Content="Pointer" Style="{StaticResource ModernBtn}" Margin="2" Click="BtnTool_Click"/>
                        <Button x:Name="BtnToolHighlight" Content="Highlight" Style="{StaticResource ModernBtn}" Foreground="#FACC15" Margin="2" Click="BtnTool_Click"/>
                        <Button x:Name="BtnToolInk" Content="Vector Ink" Style="{StaticResource ModernBtn}" Foreground="#F87171" Margin="2" Click="BtnTool_Click"/>
                        <Button x:Name="BtnToolSticky" Content="Sticky Note" Style="{StaticResource ModernBtn}" Foreground="#FB923C" Margin="2" Click="BtnTool_Click"/>
                        <Button x:Name="BtnToolSignature" Content="PKCS#7 Sign" Style="{StaticResource ModernBtn}" Foreground="#60A5FA" Margin="2" Click="BtnTool_Click"/>

                        <Separator Width="1" Height="22" Background="#3F3F46" Margin="8,0"/>

                        <!-- File & In-Document Search -->
                        <Button x:Name="BtnSaveFile" Content="Save Incremental" Style="{StaticResource AccentBtn}" Margin="2" Click="BtnSaveFile_Click"/>
                        <Button x:Name="BtnToggleSearch" Content="🔍 Find (Ctrl+F)" Style="{StaticResource ModernBtn}" Margin="6,2,2,2" Click="BtnToggleSearch_Click"/>
                    </WrapPanel>
                </Border>

                <!-- Search Panel -->
                <Border x:Name="SearchPanel" Grid.Row="2" Background="#1F1F24" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Search Document:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A1A1AA" FontSize="12"/>
                        <TextBox x:Name="TxtSearchQuery" Width="260" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="8,4" KeyUp="TxtSearchQuery_KeyUp"/>
                        <Button x:Name="BtnFindNext" Content="Next Match" Style="{StaticResource ModernBtn}" Margin="8,0,4,0" Click="BtnFindNext_Click"/>
                        <TextBlock x:Name="TxtMatchCount" Text="0 matches" VerticalAlignment="Center" Margin="8,0" Foreground="#A1A1AA" FontSize="11"/>
                        <Button x:Name="BtnCloseSearch" Content="Close" Style="{StaticResource ModernBtn}" Margin="8,0" Click="BtnCloseSearch_Click"/>
                    </StackPanel>
                </Border>

                <!-- Core Viewport & Thumbnails Filmstrip -->
                <Grid Grid.Row="3" Background="#0F0F12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/> <!-- Thumbnails Sidebar -->
                        <ColumnDefinition Width="*"/>   <!-- Main Canvas Viewport -->
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnails Sidebar -->
                    <Border Grid.Column="0" Background="#141417" BorderBrush="#27272A" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock Text="PAGE THUMBNAILS" DockPanel.Dock="Top" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="14,12,0,8"/>
                            <ListBox x:Name="ThumbnailList" Background="Transparent" BorderThickness="0" Margin="4" SelectionChanged="ThumbnailList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" Width="150" Height="200" Margin="6" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding RenderedImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" Foreground="#E4E4E7" FontWeight="Bold"/>
                                                <Border Background="#18181B" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" CornerRadius="3" Padding="6,2">
                                                    <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Main Canvas Viewport -->
                    <ScrollViewer x:Name="MainScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                                  Background="#09090B" Padding="40">
                        <Grid x:Name="CanvasContainer" HorizontalAlignment="Center">
                            <!-- Page Card Frame -->
                            <Border x:Name="PageBorder" Background="#FFFFFF" CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
                                </Border.Effect>

                                <Grid>
                                    <!-- High-DPI Real Rendered PDF Page -->
                                    <Image x:Name="ImgPageRender" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Content Stream Text (Fallback/Search overlay) -->
                                    <TextBox x:Name="TxtPageContent" Margin="48" Background="Transparent" Foreground="#18181B" 
                                             BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" FontFamily="Georgia"/>

                                    <!-- Interactive Ink & Vector Overlay Canvas -->
                                    <InkCanvas x:Name="PageInkCanvas" Background="Transparent" IsHitTestVisible="False"/>

                                    <!-- PKCS#7 Digital Signature Badge -->
                                    <Border x:Name="SignatureBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                            Margin="24" Background="#EFF6FF" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓ PKCS#7 Verified Digital Signature" FontWeight="Bold" Foreground="#0284C7" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Reader Status Bar -->
                <Border Grid.Row="4" Background="#0284C7" Padding="16,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusPage" Text="Page 1 of 1" Foreground="White" FontSize="11" Margin="0,0,16,0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusDimensions" Text="Dimensions: 612 x 792 pt" Foreground="#E0F2FE" FontSize="11" Margin="0,0,16,0"/>
                        <TextBlock Text="DirectX Hardware Acceleration: ACTIVE" Foreground="#E0F2FE" FontSize="11" Margin="0,0,16,0"/>
                        <TextBlock Text="Omni PDF Studio Desktop Engine" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#E0F2FE" FontSize="11"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
