<Window x:Class="OmniPdf.App.Views.PdfOptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSD PDF Studio &amp; Viewer - PDF Optimizer &amp; Stream Compressor"
        Height="500" Width="680" MinHeight="380" MinWidth="540"
        WindowStartupLocation="CenterOwner" Background="#121214" Foreground="#ECECEF"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="Auto"/> <!-- Space Audit Cards -->
            <RowDefinition Height="*"/>    <!-- Optimization Options & Presets -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <Border Width="32" Height="32" CornerRadius="6" Background="#0284C7" Margin="0,0,10,0">
                    <TextBlock Text="🗜️" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PDF Compression &amp; Space Optimizer" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                    <TextBlock Text="Audit internal document footprint, resample high-res images, and strip unreferenced objects" FontSize="11" Foreground="#A1A1AA"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Space Audit Cards -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ORIGINAL FOOTPRINT" FontSize="9.5" FontWeight="Bold" Foreground="#71717A"/>
                    <TextBlock x:Name="TxtOriginalSize" Text="12.4 MB" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                    <TextBlock Text="On-disk uncompressed" FontSize="9.5" Foreground="#71717A"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="ESTIMATED SAVINGS" FontSize="9.5" FontWeight="Bold" Foreground="#71717A"/>
                    <TextBlock x:Name="TxtEstimatedSavings" Text="~58% (7.2 MB)" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" Margin="0,2,0,0"/>
                    <TextBlock Text="Reduced transfer overhead" FontSize="9.5" Foreground="#71717A"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="OBJECT STREAMS" FontSize="9.5" FontWeight="Bold" Foreground="#71717A"/>
                    <TextBlock Text="Flate Linearized" FontSize="18" FontWeight="Bold" Foreground="#A78BFA" Margin="0,2,0,0"/>
                    <TextBlock Text="Fast Web View enabled" FontSize="9.5" Foreground="#71717A"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Presets -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="OPTIMIZATION PRESET" FontWeight="Bold" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,8"/>

                <ComboBox x:Name="CmbPreset" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" FontSize="11" Margin="0,0,0,14" SelectedIndex="0" SelectionChanged="CmbPreset_SelectionChanged">
                    <ComboBoxItem Content="Ultra-Compact (Web 72 DPI) - Max Size Reduction"/>
                    <ComboBoxItem Content="Standard Clean (150 DPI) - Balanced Screen &amp; Mobile"/>
                    <ComboBoxItem Content="Print Optimized (300 DPI) - Lossless Vector Quality"/>
                </ComboBox>

                <TextBlock Text="ADVANCED COMPONENT CLEANUP" FontWeight="Bold" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,8"/>
                <CheckBox Content="Discard unreferenced streams and orphaned PDF objects" IsChecked="True" Foreground="White" FontSize="11" Margin="0,3"/>
                <CheckBox Content="Flatten form fields and remove unprinted annotations" IsChecked="True" Foreground="White" FontSize="11" Margin="0,3"/>
                <CheckBox Content="Linearize output for Fast Web View byte-range streaming" IsChecked="True" Foreground="White" FontSize="11" Margin="0,3"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="TxtOptStatus" Text="Ready to optimize" VerticalAlignment="Center" FontSize="11" Foreground="#A1A1AA"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Close" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="14,6" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" Click="BtnClose_Click"/>
                <Button Content="🗜️ Compress &amp; Optimize PDF..." Background="#0284C7" Foreground="White" BorderBrush="#38BDF8" Padding="16,6" FontWeight="Bold" FontSize="11" Click="BtnOptimize_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
