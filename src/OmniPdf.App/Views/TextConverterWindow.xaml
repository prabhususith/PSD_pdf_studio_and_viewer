<Window x:Class="OmniPdf.App.Views.TextConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dual-Direction Text Converter - PDF &lt;-&gt; Text &amp; Markdown"
        Height="560" Width="900" MinHeight="400" MinWidth="650"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#FFFFFF"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Dual-Direction Text Converter" FontSize="20" FontWeight="Bold" Foreground="#4CC2FF"/>
            <TextBlock Text="Convert PDF content streams to UTF-8 plain text / Markdown, or compile raw text into paginated PDFs." FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="#252526" BorderBrush="#383838">
            <!-- TAB 1: PDF to Text / Markdown -->
            <TabItem Header="PDF to Text &amp; Markdown (.md)" Foreground="White" Background="#2D2D30">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Extracted Document Content Stream:" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,6"/>

                    <TextBox x:Name="TxtExtracted" Grid.Row="1" Background="#141414" Foreground="#DDDDDD" 
                             BorderBrush="#444444" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                             FontFamily="Consolas" FontSize="12" Padding="12"/>

                    <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="BtnExportTxt" Content="Export as Plain Text (.txt)" Padding="14,8" Margin="4,0" Background="#008080" Foreground="White" BorderThickness="0" Click="BtnExportTxt_Click"/>
                        <Button x:Name="BtnExportMd" Content="Export as Markdown (.md)" Padding="14,8" Margin="4,0" Background="#68217A" Foreground="White" BorderThickness="0" Click="BtnExportMd_Click"/>
                        <Button x:Name="BtnEmbedOcr" Content="Embed Searchable OCR Layer (3 Tr)" Padding="14,8" Margin="4,0" Background="#0078D4" Foreground="White" BorderThickness="0" Click="BtnEmbedOcr_Click"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: Text to PDF Engine -->
            <TabItem Header="Dynamic Text-to-PDF Engine" Foreground="White" Background="#2D2D30">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Settings -->
                    <Border Grid.Row="0" Background="#202020" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Font Size:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,6,0" FontSize="11"/>
                            <Slider x:Name="SliderFontSize" Width="140" Minimum="8" Maximum="32" Value="12" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderFontSize_ValueChanged"/>
                            <TextBlock x:Name="TxtFontSizeVal" Text="12 pt" Width="40" VerticalAlignment="Center" Foreground="#DDDDDD" Margin="6,0,16,0" FontSize="11"/>

                            <TextBlock Text="Watermark:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,6,0" FontSize="11"/>
                            <TextBox x:Name="TxtWatermark" Width="160" Text="CONFIDENTIAL" Background="#141414" Foreground="White" BorderBrush="#444444" Padding="4,2"/>

                            <TextBlock Text="Margins: 0.75 in (54 pt)" VerticalAlignment="Center" Foreground="#777777" Margin="16,0,0,0" FontSize="11"/>
                        </WrapPanel>
                    </Border>

                    <TextBox x:Name="TxtInputForPdf" Grid.Row="1" Background="#141414" Foreground="#DDDDDD" 
                             BorderBrush="#444444" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                             FontFamily="Georgia" FontSize="13" Padding="12"
                             Text="Omni PDF Studio - Standardized Vector Flow Document&#x0a;&#x0a;This document was generated using the dynamic Text-to-PDF compilation engine.&#x0a;It features automatic text wrapping, line spacing calculation, pagination stamps (Page N of M), and custom diagonal watermarking."/>

                    <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="BtnCompileTextPdf" Content="Compile into Standardized PDF Document" Padding="18,10" Background="#107C41" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnCompileTextPdf_Click"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="UTF-8 Unicode encoding fully supported (Latin, CMap, and Indic streams)." VerticalAlignment="Center" Foreground="#888888" FontSize="11"/>
            <Button x:Name="BtnClose" Content="Close" Width="90" Height="32" HorizontalAlignment="Right" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
