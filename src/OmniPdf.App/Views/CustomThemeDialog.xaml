<Window x:Class="OmniPdf.App.Views.CustomThemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSD Theme Studio &amp; Custom Color Palette Engine"
        Height="620" Width="920" MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#ECECEF"
        FontFamily="Segoe UI Variable Text, Segoe UI, Arial">

    <Window.Resources>
        <Style x:Key="PaletteChip" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioBtn" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="*"/>    <!-- Main Body: Pickers (Left) + Live Preview (Right) -->
            <RowDefinition Height="Auto"/> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎨" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PSD Theme Studio &amp; Custom Color Palette" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Choose from 105+ enterprise theme presets or sculpt your personalized custom theme with infinite color palettes." FontSize="11" Foreground="#A1A1AA" Margin="30,2,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Start from Preset:" VerticalAlignment="Center" Foreground="#A1A1AA" FontSize="11" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbPresetStarter" Width="180" Height="26" FontSize="11"
                          Background="#27272A" Foreground="#F4F4F5" BorderBrush="#3F3F46"
                          SelectionChanged="CmbPresetStarter_SelectionChanged"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/> <!-- Palette Controls & Inputs -->
                <ColumnDefinition Width="16"/>  <!-- Spacer -->
                <ColumnDefinition Width="*"/>   <!-- Live Preview Board -->
            </Grid.ColumnDefinitions>

            <!-- Left: Color Channels & Palette Grid -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <!-- Quick Palette Color Swatches -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="QUICK COLOR PALETTE SWATCHES" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="WrapSwatches" Orientation="Horizontal"/>
                            <TextBlock Text="Click a swatch to apply it to the currently focused color channel below." FontSize="9.5" Foreground="#71717A" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Channel 1: Window Background -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Width="140">
                                <TextBlock Text="Window Background" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="Scaffold &amp; backdrop" FontSize="9" Foreground="#A1A1AA"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ChipWinBg" Width="26" Height="26" CornerRadius="4" BorderBrush="#71717A" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtWinBg" Width="74" Height="26" Background="#18181B" Foreground="White" BorderBrush="#3F3F46" Padding="4,2" FontSize="11" TextChanged="ColorField_TextChanged" GotFocus="ColorField_GotFocus"/>
                                <Button Content="Pick" Style="{StaticResource StudioBtn}" Padding="8,4" Height="26" Margin="4,0,0,0" Click="BtnPickColor_Click" Tag="WinBg"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Channel 2: Text / Font Color -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Width="140">
                                <TextBlock Text="Text &amp; Font Color" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="Primary body &amp; headers" FontSize="9" Foreground="#A1A1AA"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ChipWinFg" Width="26" Height="26" CornerRadius="4" BorderBrush="#71717A" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtWinFg" Width="74" Height="26" Background="#18181B" Foreground="White" BorderBrush="#3F3F46" Padding="4,2" FontSize="11" TextChanged="ColorField_TextChanged" GotFocus="ColorField_GotFocus"/>
                                <Button Content="Pick" Style="{StaticResource StudioBtn}" Padding="8,4" Height="26" Margin="4,0,0,0" Click="BtnPickColor_Click" Tag="WinFg"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Channel 3: Header & Menu Bar -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Width="140">
                                <TextBlock Text="Header &amp; Menu Bar" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="Top bar &amp; menus" FontSize="9" Foreground="#A1A1AA"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ChipHeaderBg" Width="26" Height="26" CornerRadius="4" BorderBrush="#71717A" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtHeaderBg" Width="74" Height="26" Background="#18181B" Foreground="White" BorderBrush="#3F3F46" Padding="4,2" FontSize="11" TextChanged="ColorField_TextChanged" GotFocus="ColorField_GotFocus"/>
                                <Button Content="Pick" Style="{StaticResource StudioBtn}" Padding="8,4" Height="26" Margin="4,0,0,0" Click="BtnPickColor_Click" Tag="HeaderBg"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Channel 4: Accent & Highlight Color -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Width="140">
                                <TextBlock Text="Accent &amp; Primary Highlight" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="Buttons, badges, focus rings" FontSize="9" Foreground="#A1A1AA"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ChipAccentDef" Width="26" Height="26" CornerRadius="4" BorderBrush="#71717A" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtAccentDef" Width="74" Height="26" Background="#18181B" Foreground="White" BorderBrush="#3F3F46" Padding="4,2" FontSize="11" TextChanged="ColorField_TextChanged" GotFocus="ColorField_GotFocus"/>
                                <Button Content="Pick" Style="{StaticResource StudioBtn}" Padding="8,4" Height="26" Margin="4,0,0,0" Click="BtnPickColor_Click" Tag="AccentDef"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Channel 5: Canvas / Viewport Backdrop -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Width="140">
                                <TextBlock Text="Document Canvas Backdrop" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="Area behind PDF pages" FontSize="9" Foreground="#A1A1AA"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ChipCanvasBg" Width="26" Height="26" CornerRadius="4" BorderBrush="#71717A" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtCanvasBg" Width="74" Height="26" Background="#18181B" Foreground="White" BorderBrush="#3F3F46" Padding="4,2" FontSize="11" TextChanged="ColorField_TextChanged" GotFocus="ColorField_GotFocus"/>
                                <Button Content="Pick" Style="{StaticResource StudioBtn}" Padding="8,4" Height="26" Margin="4,0,0,0" Click="BtnPickColor_Click" Tag="CanvasBg"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Channel 6: Status Bar -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Width="140">
                                <TextBlock Text="Status Bar Color" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="Bottom status strip" FontSize="9" Foreground="#A1A1AA"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ChipStatusBg" Width="26" Height="26" CornerRadius="4" BorderBrush="#71717A" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtStatusBg" Width="74" Height="26" Background="#18181B" Foreground="White" BorderBrush="#3F3F46" Padding="4,2" FontSize="11" TextChanged="ColorField_TextChanged" GotFocus="ColorField_GotFocus"/>
                                <Button Content="Pick" Style="{StaticResource StudioBtn}" Padding="8,4" Height="26" Margin="4,0,0,0" Click="BtnPickColor_Click" Tag="StatusBg"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: Real-time Interactive UI Live Preview Board -->
            <Border Grid.Column="2" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Preview Header Title -->
                        <RowDefinition Height="*"/>    <!-- Mock UI Preview Container -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="REAL-TIME THEME LIVE PREVIEW" FontWeight="Bold" FontSize="10" Foreground="#38BDF8"/>
                        <TextBlock x:Name="TxtThemeNameDisplay" Text="Custom Palette" HorizontalAlignment="Right" FontSize="10" Foreground="#71717A" FontWeight="SemiBold"/>
                    </DockPanel>

                    <!-- Mock Window Container -->
                    <Border Grid.Row="1" x:Name="PrevWindow" CornerRadius="8" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Mock Header / Menu -->
                                <RowDefinition Height="Auto"/> <!-- Mock Ribbon -->
                                <RowDefinition Height="*"/>    <!-- Mock Viewport -->
                                <RowDefinition Height="Auto"/> <!-- Mock Status Bar -->
                            </Grid.RowDefinitions>

                            <!-- Mock Header -->
                            <Border Grid.Row="0" x:Name="PrevHeader" Padding="10,6" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="PrevLogoBadge" Width="24" Height="18" CornerRadius="3" Margin="0,0,6,0">
                                            <TextBlock Text="PSD" FontSize="8.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="PrevTitleText" Text="PSD PDF Studio &amp; Viewer" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="2,0"/>
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="2,0"/>
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="2,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Mock Ribbon -->
                            <Border Grid.Row="1" x:Name="PrevRibbon" Padding="8,4" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="PrevBtnAccent" CornerRadius="4" Padding="8,3" Margin="0,0,4,0">
                                        <TextBlock Text="📄 Document View" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <Border x:Name="PrevBtnOutline" CornerRadius="4" Padding="8,3" Margin="0,0,4,0" BorderThickness="1">
                                        <TextBlock x:Name="PrevBtnOutlineText" Text="🔍 Find Text" FontSize="9.5"/>
                                    </Border>
                                    <Border x:Name="PrevBtnTool" CornerRadius="4" Padding="8,3" Margin="0,0,4,0" BorderThickness="1">
                                        <TextBlock x:Name="PrevBtnToolText" Text="✏️ Sketch" FontSize="9.5"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Mock Viewport with PDF page -->
                            <Border Grid.Row="2" x:Name="PrevCanvas" Padding="14">
                                <Border x:Name="PrevPage" Width="200" Height="260" Background="#FFFFFF" CornerRadius="4" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.3" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Height="8" Width="90" Background="#0284C7" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,8"/>
                                        <Border Height="4" Width="170" Background="#E2E8F0" HorizontalAlignment="Left" CornerRadius="1" Margin="0,0,0,4"/>
                                        <Border Height="4" Width="150" Background="#E2E8F0" HorizontalAlignment="Left" CornerRadius="1" Margin="0,0,0,4"/>
                                        <Border Height="4" Width="160" Background="#E2E8F0" HorizontalAlignment="Left" CornerRadius="1" Margin="0,0,0,8"/>
                                        <Border Height="50" Width="170" Background="#F1F5F9" CornerRadius="3" Margin="0,0,0,8"/>
                                        <Border Height="4" Width="140" Background="#E2E8F0" HorizontalAlignment="Left" CornerRadius="1" Margin="0,0,0,4"/>
                                        <Border Height="4" Width="110" Background="#E2E8F0" HorizontalAlignment="Left" CornerRadius="1" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Border>
                            </Border>

                            <!-- Mock Status Bar -->
                            <Border Grid.Row="3" x:Name="PrevStatusBar" Padding="8,3">
                                <DockPanel>
                                    <TextBlock x:Name="PrevStatusText" Text="Page 1 of 1 • 100% Vector Zoom • Ready" FontSize="9.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PrevStatusRight" Text="PKCS#7 SHA-256" HorizontalAlignment="Right" FontSize="9.5"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💡 Hint: Choose any of the 105 preset themes from the top-right dropdown to inspect or remix its colors." FontSize="10.5" Foreground="#71717A"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset to Default" Style="{StaticResource StudioBtn}" Margin="0,0,8,0" Click="BtnReset_Click"/>
                <Button Content="Cancel" Style="{StaticResource StudioBtn}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnApplyAndSave" Content="Apply &amp; Save Custom Theme" Style="{StaticResource StudioBtn}" 
                        Background="#0284C7" Foreground="White" BorderThickness="0" Padding="16,6"
                        Click="BtnApplyAndSave_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
