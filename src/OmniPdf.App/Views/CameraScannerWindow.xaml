<Window x:Class="OmniPdf.App.Views.CameraScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Document Scanner &amp; Perspective Warp Sub-Engine"
        Height="640" Width="980" MinHeight="480" MinWidth="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#ECECEF"
        FontFamily="Segoe UI Variable Text, Segoe UI, Arial">

    <Window.Resources>
        <Style x:Key="ScannerBtn" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Camera Status -->
            <RowDefinition Height="Auto"/> <!-- Controls Ribbon -->
            <RowDefinition Height="*"/>    <!-- Image Viewport + Handles -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📷" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Camera Document Scanner &amp; Perspective Warp" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Direct hardware webcam capture, Windows Camera companion, and 4-corner perspective calibration." FontSize="11" Foreground="#A1A1AA" Margin="28,2,0,0"/>
            </StackPanel>

            <!-- Live Camera Status Indicator -->
            <Border DockPanel.Dock="Right" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="16" Padding="12,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCameraStatus" Text="Camera Ready (WebCam &amp; Windows Camera Linked)" FontSize="10.5" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Controls Ribbon -->
        <Border Grid.Row="1" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Direct Hardware Camera Capture -->
                <Button x:Name="BtnCaptureCamera" Content="📷 Take Photo with Camera" Padding="14,6" Margin="2" 
                        Background="#0284C7" Foreground="White" BorderThickness="0" Style="{StaticResource ScannerBtn}"
                        ToolTip="Capture directly from connected webcam or launch Windows Camera companion"
                        Click="BtnCaptureCamera_Click"/>

                <!-- Paste from Clipboard -->
                <Button x:Name="BtnPasteClipboard" Content="📋 Paste Clipboard" Margin="2" Style="{StaticResource ScannerBtn}"
                        ToolTip="Paste screenshot or photo from clipboard (Ctrl+V)"
                        Click="BtnPasteClipboard_Click"/>

                <!-- Import Scan File -->
                <Button x:Name="BtnLoadImage" Content="📁 Import File" Margin="2" Style="{StaticResource ScannerBtn}"
                        ToolTip="Select JPG, PNG, or BMP image"
                        Click="BtnLoadImage_Click"/>

                <!-- Sample Presets Dropdown -->
                <ComboBox x:Name="CmbSampleDoc" Width="140" Height="26" Margin="2" FontSize="11"
                          Background="#18181B" Foreground="#F4F4F5" BorderBrush="#3F3F46"
                          ToolTip="Load sample document to test perspective warp and binarization"
                          SelectionChanged="CmbSampleDoc_SelectionChanged">
                    <ComboBoxItem Content="📄 Sample: Invoice" IsSelected="True"/>
                    <ComboBoxItem Content="📜 Sample: Legal Contract"/>
                    <ComboBoxItem Content="🧾 Sample: Receipt"/>
                    <ComboBoxItem Content="📊 Sample: Blueprint"/>
                </ComboBox>

                <Separator Width="1" Height="20" Background="#3F3F46" Margin="8,0"/>

                <!-- Perspective Warp Controls -->
                <Button x:Name="BtnAutoDetect" Content="📐 Auto-Detect Corners" Margin="2" Style="{StaticResource ScannerBtn}"
                        ToolTip="Compute document boundary quadrilateral"
                        Click="BtnAutoDetect_Click"/>
                <Button x:Name="BtnWarp" Content="✨ Warp Perspective" Margin="2" 
                        Background="#9333EA" Foreground="White" BorderThickness="0" Style="{StaticResource ScannerBtn}"
                        ToolTip="Straighten perspective keystoning into flat orthogonal document"
                        Click="BtnWarp_Click"/>

                <Separator Width="1" Height="20" Background="#3F3F46" Margin="8,0"/>

                <!-- Filters -->
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="4,0" Foreground="#A1A1AA" FontSize="11"/>
                <Button x:Name="BtnFilterOriginal" Content="Original" Margin="2" Style="{StaticResource ScannerBtn}" Click="BtnFilter_Click"/>
                <Button x:Name="BtnFilterMagicColor" Content="Magic Color" Margin="2" Background="#D97706" Foreground="White" BorderThickness="0" Style="{StaticResource ScannerBtn}" Click="BtnFilter_Click"/>
                <Button x:Name="BtnFilterOtsu" Content="B&amp;W Otsu" Margin="2" Background="#FAFAFA" Foreground="Black" FontWeight="Bold" BorderThickness="0" Style="{StaticResource ScannerBtn}" Click="BtnFilter_Click"/>
                <Button x:Name="BtnFilterGrayscale" Content="Grayscale" Margin="2" Style="{StaticResource ScannerBtn}" Click="BtnFilter_Click"/>

                <Separator Width="1" Height="20" Background="#3F3F46" Margin="8,0"/>

                <TextBlock x:Name="TxtResolution" Text="Resolution: 1080p preview" VerticalAlignment="Center" Foreground="#71717A" FontSize="10.5"/>
            </WrapPanel>
        </Border>

        <!-- Image & Handles Canvas Viewport -->
        <Border Grid.Row="2" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid x:Name="ViewerContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="ImgPreview" Stretch="Uniform" MaxHeight="520" MaxWidth="820"/>

                <!-- 4-corner boundary overlay polygon and drag handles -->
                <Canvas x:Name="OverlayCanvas">
                    <Polygon x:Name="QuadPolygon" Fill="#330284C7" Stroke="#38BDF8" StrokeThickness="2.5"/>

                    <!-- 4 Handles -->
                    <Thumb x:Name="HandleTL" Width="22" Height="22" Background="#0284C7" BorderBrush="White" BorderThickness="2" DragDelta="Handle_DragDelta"/>
                    <Thumb x:Name="HandleTR" Width="22" Height="22" Background="#0284C7" BorderBrush="White" BorderThickness="2" DragDelta="Handle_DragDelta"/>
                    <Thumb x:Name="HandleBR" Width="22" Height="22" Background="#0284C7" BorderBrush="White" BorderThickness="2" DragDelta="Handle_DragDelta"/>
                    <Thumb x:Name="HandleBL" Width="22" Height="22" Background="#0284C7" BorderBrush="White" BorderThickness="2" DragDelta="Handle_DragDelta"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Otsu binarization cleans shadows and removes paper yellowing for crisp vector printing." Foreground="#71717A" FontSize="11"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Close" Style="{StaticResource ScannerBtn}" Width="80" Height="32" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnCompilePdf" Content="📄 Compile into Document PDF" Width="220" Height="32" 
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Style="{StaticResource ScannerBtn}"
                        Click="BtnCompilePdf_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
