<Window x:Class="OmniPdf.App.Views.WatermarkAndHeaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omni Studio Enterprise - Watermark, Headers &amp; Footers"
        Height="520" Width="740" MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner" Background="#121214" Foreground="#ECECEF"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <DockPanel>
                <Border Width="32" Height="32" CornerRadius="6" Background="#0284C7" Margin="0,0,10,0">
                    <TextBlock Text="💧" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Watermark, Header &amp; Footer Studio" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                    <TextBlock Text="Stamp custom translucent watermarks, confidential badges, dynamic page numbers, and headers" FontSize="11" Foreground="#A1A1AA"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="#18181B" BorderBrush="#27272A" Margin="0,0,0,12">
            <!-- TAB 1: WATERMARK -->
            <TabItem Header="💧 Dynamic Watermark">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Settings -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="WATERMARK TEXT" FontWeight="Bold" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtWatermarkText" Text="CONFIDENTIAL" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="6,3" FontSize="12" Margin="0,0,0,10" TextChanged="Settings_Changed"/>

                        <TextBlock Text="OPACITY: 25%" x:Name="LblOpacity" FontWeight="Bold" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,4"/>
                        <Slider x:Name="SliderOpacity" Minimum="5" Maximum="100" Value="25" Margin="0,0,0,10" ValueChanged="SliderOpacity_ValueChanged"/>

                        <TextBlock Text="ROTATION ANGLE: -45°" x:Name="LblAngle" FontWeight="Bold" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,4"/>
                        <Slider x:Name="SliderAngle" Minimum="-90" Maximum="90" Value="-45" Margin="0,0,0,10" ValueChanged="SliderAngle_ValueChanged"/>

                        <TextBlock Text="PRESET TEMPLATES" FontWeight="Bold" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,4"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="CONFIDENTIAL" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="6,2" FontSize="10" Margin="0,0,4,4" Click="BtnPreset_Click"/>
                            <Button Content="DRAFT" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="6,2" FontSize="10" Margin="0,0,4,4" Click="BtnPreset_Click"/>
                            <Button Content="APPROVED" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="6,2" FontSize="10" Margin="0,0,4,4" Click="BtnPreset_Click"/>
                            <Button Content="RESTRICTED" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="6,2" FontSize="10" Click="BtnPreset_Click"/>
                        </WrapPanel>

                        <Button Content="💧 Stamp Watermark to All Pages" Background="#0284C7" Foreground="White" BorderBrush="#38BDF8" Padding="12,6" FontWeight="Bold" FontSize="11" Click="BtnApplyWatermark_Click"/>
                    </StackPanel>

                    <!-- Right: Live Visual Preview Card -->
                    <Border Grid.Column="1" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <!-- Mini Page Canvas Preview -->
                            <Border Width="190" Height="250" Background="#FFFFFF" CornerRadius="4">
                                <Grid ClipToBounds="True">
                                    <StackPanel Margin="16" Opacity="0.3">
                                        <Border Height="8" Background="#CBD5E1" Margin="0,0,40,6"/>
                                        <Border Height="6" Background="#E2E8F0" Margin="0,0,0,4"/>
                                        <Border Height="6" Background="#E2E8F0" Margin="0,0,10,4"/>
                                        <Border Height="6" Background="#E2E8F0" Margin="0,0,20,4"/>
                                        <Border Height="6" Background="#E2E8F0" Margin="0,0,0,4"/>
                                        <Border Height="6" Background="#E2E8F0" Margin="0,0,15,4"/>
                                    </StackPanel>

                                    <!-- Rendered Watermark Text -->
                                    <TextBlock x:Name="TxtPreviewWatermark" Text="CONFIDENTIAL" FontSize="20" FontWeight="Bold" 
                                               Foreground="#EF4444" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform x:Name="RotatePreview" Angle="-45"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: HEADER & FOOTER -->
            <TabItem Header="📑 Header &amp; Footer Stamping">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="HEADER TEXT (TOP OF PAGE)" FontWeight="Bold" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtHLeft" Text="Omni Document" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="5,2" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtHCenter" Text="" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="5,2" Margin="2,0"/>
                            <TextBox Grid.Column="2" x:Name="TxtHRight" Text="[Date]" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="5,2" Margin="4,0,0,0"/>
                        </Grid>

                        <TextBlock Text="FOOTER TEXT (BOTTOM OF PAGE)" FontWeight="Bold" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtFLeft" Text="Confidential" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="5,2" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtFCenter" Text="Page [Page] of [Pages]" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="5,2" Margin="2,0"/>
                            <TextBox Grid.Column="2" x:Name="TxtFRight" Text="" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="5,2" Margin="4,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Supported tokens: [Page] for page number, [Pages] for total count, [Date] for current date." FontSize="10.5" Foreground="#A1A1AA" Margin="0,0,0,16"/>

                        <Button Content="📑 Stamp Headers &amp; Footers to Document" Background="#0284C7" Foreground="White" BorderBrush="#38BDF8" Padding="12,6" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left" Click="BtnApplyHeaderFooter_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <DockPanel Grid.Row="2">
            <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="16,5" FontWeight="SemiBold" FontSize="11" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
