<Window x:Class="OmniPdf.App.Views.ElectronicSignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise e-Signature &amp; Audit Trail Studio"
        Height="620" Width="780" MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F12" Foreground="#ECECEF"
        FontFamily="Segoe UI" WindowStyle="SingleBorderWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Signature Studio Tabs -->
            <RowDefinition Height="Auto"/> <!-- Certificate Stamp Preview -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#27272A" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔏 " FontSize="20"/>
                        <TextBlock Text="ENTERPRISE ELECTRONIC SIGNATURE STUDIO" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                    <TextBlock Text="DocuSign &amp; Adobe Sign Parity — PKCS#7 SHA-256 Non-Repudiation Audit Trail" FontSize="11" Foreground="#A1A1AA" Margin="28,2,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#14532D" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="✓ AUDIT TRAIL READY" FontSize="10" FontWeight="Bold" Foreground="#4ADE80"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Signature Studio Tabs -->
        <TabControl Grid.Row="1" Background="#18181B" BorderBrush="#27272A" Margin="0,0,0,14">
            <!-- TAB 1: Draw Signature -->
            <TabItem Header="✍️ Draw Signature">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                        <Grid>
                            <InkCanvas x:Name="SignInkCanvas" Background="Transparent"/>
                            <TextBlock Text="Sign with mouse, pen, or touch here..." Foreground="#94A3B8" FontStyle="Italic" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                       x:Name="TxtDrawPlaceholder"/>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Ink Color:" VerticalAlignment="Center" Foreground="#A1A1AA" Margin="0,0,8,0" FontSize="11"/>
                            <RadioButton x:Name="RbInkBlue" Content="Executive Blue" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" Checked="RbInkColor_Checked"/>
                            <RadioButton x:Name="RbInkBlack" Content="Formal Black" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" Checked="RbInkColor_Checked"/>
                        </StackPanel>
                        <Button Content="Clear Signature" Width="110" Height="26" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#27272A" Foreground="#F87171" BorderThickness="0" Click="BtnClearInk_Click"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: Type Calligraphy Signature -->
            <TabItem Header="⌨️ Type Signature">
                <StackPanel Margin="16">
                    <TextBlock Text="Enter Your Full Name:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTypeName" Text="Alexandra Chen" Height="30" Padding="8,4" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" TextChanged="TxtTypeName_TextChanged"/>

                    <TextBlock Text="Select Calligraphy Style:" Foreground="#A1A1AA" FontSize="11" Margin="0,12,0,8"/>
                    
                    <Border Background="#FFFFFF" CornerRadius="6" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <RadioButton x:Name="RbStyle1" IsChecked="True" GroupName="TypeStyles" Margin="0,4" Checked="RbStyle_Checked">
                                <TextBlock x:Name="LblStyle1" Text="Alexandra Chen" FontFamily="Segoe Script" FontSize="26" Foreground="#1E3A8A"/>
                            </RadioButton>
                            <RadioButton x:Name="RbStyle2" GroupName="TypeStyles" Margin="0,4" Checked="RbStyle_Checked">
                                <TextBlock x:Name="LblStyle2" Text="Alexandra Chen" FontFamily="Lucida Handwriting" FontSize="24" Foreground="#18181B"/>
                            </RadioButton>
                            <RadioButton x:Name="RbStyle3" GroupName="TypeStyles" Margin="0,4" Checked="RbStyle_Checked">
                                <TextBlock x:Name="LblStyle3" Text="Alexandra Chen" FontFamily="Mistral" FontSize="30" Foreground="#0F172A"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- TAB 3: Signer Credentials & Audit Information -->
            <TabItem Header="📋 Signer Credentials &amp; Intent">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="Signer Full Name:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtSignerName" Text="Alexandra Chen" Height="28" Padding="6,3" Background="#27272A" Foreground="White" BorderBrush="#3F3F46"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="Corporate Title:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtSignerTitle" Text="Principal Enterprise Architect" Height="28" Padding="6,3" Background="#27272A" Foreground="White" BorderBrush="#3F3F46"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="Email Address:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtSignerEmail" Text="alexandra.chen@psdsoftware.io" Height="28" Padding="6,3" Background="#27272A" Foreground="White" BorderBrush="#3F3F46"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="Organization / Company:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtSignerOrg" Text="PSD Software Studio Global Inc." Height="28" Padding="6,3" Background="#27272A" Foreground="White" BorderBrush="#3F3F46"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <TextBlock Text="Reason for Signing:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbSignReason" Height="28" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" SelectedIndex="0">
                                <ComboBoxItem Content="I approve and accept the terms and conditions of this document."/>
                                <ComboBoxItem Content="I have reviewed and certified this technical specification."/>
                                <ComboBoxItem Content="Official executive authorization and approval sign-off."/>
                                <ComboBoxItem Content="I am the author / owner certifying authenticity."/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="Signing Location (City, Country):" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtSignerLocation" Text="Seattle, WA, USA" Height="28" Padding="6,3" Background="#27272A" Foreground="White" BorderBrush="#3F3F46"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="Envelope Cryptographic Hash:" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtHashPreview" Text="SHA256: 8f4a2b9c7d1e3f5a0b..." Height="28" Padding="6,3" Background="#18181B" Foreground="#38BDF8" BorderBrush="#3F3F46" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Certificate Stamp Preview Box -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" Background="#0284C7" CornerRadius="22" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCertSigner" Text="Digitally Signed by: Alexandra Chen" FontWeight="Bold" Foreground="#38BDF8" FontSize="11.5"/>
                    <TextBlock x:Name="TxtCertMeta" Text="Organization: PSD Software Studio Global Inc. | Timestamp: 2026-10-19 UTC | Location: Seattle, WA" Foreground="#A1A1AA" FontSize="10"/>
                    <TextBlock x:Name="TxtCertHash" Text="SHA-256 Checksum: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" Foreground="#71717A" FontSize="9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="3">
            <Button Content="Copy Audit Certificate Info" Height="30" Padding="10,0" DockPanel.Dock="Left" Background="#27272A" Foreground="#38BDF8" BorderThickness="0" Click="BtnCopyCert_Click"/>
            
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Background="#27272A" Foreground="White" BorderThickness="0" IsCancel="True"/>
                <Button Content="✓ Apply Digital Signature" Width="180" Height="30" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" IsDefault="True" Click="BtnApplySignature_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
