<Window x:Class="OmniPdf.App.Views.DocumentPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Properties - Omni PDF Studio Enterprise"
        Height="540" Width="640" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner" Background="#121214" Foreground="#ECECEF"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="*"/>    <!-- Tabbed Properties -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <Border Width="34" Height="34" CornerRadius="6" Background="#0284C7" Margin="0,0,10,0">
                    <TextBlock Text="ℹ️" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Document Properties &amp; Metadata" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                    <TextBlock Text="Inspect document specifications, edit searchable metadata tags, and view security restrictions" FontSize="11" Foreground="#A1A1AA"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tabbed Inspector -->
        <TabControl Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" Margin="0,0,0,14">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#18181B"/>
                    <Setter Property="Foreground" Value="#A1A1AA"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#27272A" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Description / File Info -->
            <TabItem Header="Description">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="File Name:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFileName" Text="Sample.pdf" Foreground="#F4F4F5" Margin="0,4" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File Location:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFilePath" Text="C:\Documents\Sample.pdf" Foreground="#38BDF8" Margin="0,4" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="File Size:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtFileSize" Text="1.24 MB (1,300,480 bytes)" Foreground="#F4F4F5" Margin="0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Page Count:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPageCount" Text="12 Pages" Foreground="#4ADE80" FontWeight="Bold" Margin="0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Page Dimensions:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtDimensions" Text="612 x 792 pt (8.5 x 11.0 in, Letter)" Foreground="#F4F4F5" Margin="0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="PDF Specification:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="PDF 1.7 (ISO 32000-1) / PDF 2.0 Compliant" Foreground="#F4F4F5" Margin="0,4"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Fast Web View:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Yes (Linearized object stream)" Foreground="#38BDF8" Margin="0,4"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Application Producer:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Omni PDF Studio &amp; Word Suite Enterprise" Foreground="#A1A1AA" Margin="0,4"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Metadata (Editable) -->
            <TabItem Header="Metadata">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Document Title:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMetaTitle" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,0,10"/>

                        <TextBlock Text="Author:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMetaAuthor" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,0,10"/>

                        <TextBlock Text="Subject / Category:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMetaSubject" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,0,10"/>

                        <TextBlock Text="Keywords (Comma separated):" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMetaKeywords" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,0,14"/>

                        <TextBlock Text="💡 These metadata fields are indexed by Windows Search, Google Drive, SharePoint, and enterprise document management systems." 
                                   Foreground="#71717A" FontSize="10.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Security & Restrictions -->
            <TabItem Header="Security">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Security Method:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Standard / AES-256 Enterprise" Foreground="#4ADE80" FontWeight="Bold" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Printing:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Allowed (High Resolution)" Foreground="#F4F4F5" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Document Changes:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Allowed (Full Assembly &amp; Edit)" Foreground="#F4F4F5" Margin="0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Document Assembly:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Allowed" Foreground="#F4F4F5" Margin="0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Content Copying:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Allowed" Foreground="#F4F4F5" Margin="0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Screen Readers &amp; Accessibility:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Allowed" Foreground="#F4F4F5" Margin="0,4"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Form Field Filling:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Allowed" Foreground="#F4F4F5" Margin="0,4"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Signing &amp; Annotating:" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,4"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Allowed" Foreground="#F4F4F5" Margin="0,4"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Actions -->
        <Border Grid.Row="2">
            <DockPanel LastChildFill="False">
                <Button Content="💾 Apply Metadata" Background="#0284C7" Foreground="White" BorderThickness="0" 
                        Padding="14,6" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Click="BtnApply_Click"/>
                <Button Content="✕ Close" Background="#27272A" Foreground="#ECECEF" BorderBrush="#3F3F46" BorderThickness="1" 
                        Padding="14,6" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" DockPanel.Dock="Right" Click="BtnClose_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
