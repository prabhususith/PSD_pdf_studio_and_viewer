<Window x:Class="OmniPdf.App.Views.DocumentDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omni Studio Enterprise - Visual &amp; Text Document Comparison (Diff)"
        Height="580" Width="920" MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="#121214" Foreground="#ECECEF"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="Auto"/> <!-- Document Pickers & Summary Bar -->
            <RowDefinition Height="*"/>    <!-- Side-by-Side Dual Viewport -->
            <RowDefinition Height="Auto"/> <!-- Diff Legend & Close -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <DockPanel>
                <Border Width="32" Height="32" CornerRadius="6" Background="#0284C7" Margin="0,0,10,0">
                    <TextBlock Text="🔍" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Document Diff &amp; Revision Comparison" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                    <TextBlock Text="Compare two PDF or Office documents side-by-side with visual text addition and deletion highlighting" FontSize="11" Foreground="#A1A1AA"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Document Pickers & Telemetry -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Document A: Original -->
                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                    <TextBlock Text="ORIGINAL (DOC A):" FontWeight="Bold" FontSize="10" Foreground="#71717A" Width="110" VerticalAlignment="Center"/>
                    <Button Content="Browse..." DockPanel.Dock="Right" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="8,2" FontSize="10.5" Margin="6,0,0,0" Click="BtnBrowseDocA_Click"/>
                    <TextBox x:Name="TxtDocAPath" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="4,2" FontSize="11"/>
                </DockPanel>

                <!-- Document B: Revised -->
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,8">
                    <TextBlock Text="REVISED (DOC B):" FontWeight="Bold" FontSize="10" Foreground="#71717A" Width="100" VerticalAlignment="Center"/>
                    <Button Content="Browse..." DockPanel.Dock="Right" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="8,2" FontSize="10.5" Margin="6,0,0,0" Click="BtnBrowseDocB_Click"/>
                    <TextBox x:Name="TxtDocBPath" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="4,2" FontSize="11"/>
                </DockPanel>

                <!-- Comparison Metrics Bar -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#222228" CornerRadius="4" Padding="10,6">
                    <DockPanel>
                        <Button Content="⚡ Compare Revisions Now" DockPanel.Dock="Right" Background="#0284C7" Foreground="White" BorderBrush="#38BDF8" Padding="14,4" FontWeight="Bold" FontSize="11" Click="BtnRunCompare_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDiffScore" Text="Similarity Score: 100%" FontWeight="Bold" FontSize="12" Foreground="#4ADE80" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TxtAdditions" Text="Additions: 0" FontSize="11" Foreground="#4ADE80" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtDeletions" Text="Deletions: 0" FontSize="11" Foreground="#F87171" Margin="0,0,12,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Side-by-Side Dual Viewport -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Original Panel -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#202026" Padding="8,5" BorderBrush="#27272A" BorderThickness="0,0,0,1">
                        <TextBlock Text="Document A: Original Content View" FontWeight="Bold" FontSize="10.5" Foreground="#A1A1AA"/>
                    </Border>
                    <TextBox x:Name="TxtContentA" Background="#121214" Foreground="#ECECEF" BorderThickness="0" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas, Segoe UI"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="#27272A" HorizontalAlignment="Stretch"/>

            <!-- Revised Panel -->
            <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#202026" Padding="8,5" BorderBrush="#27272A" BorderThickness="0,0,0,1">
                        <TextBlock Text="Document B: Revised / Changes View" FontWeight="Bold" FontSize="10.5" Foreground="#A1A1AA"/>
                    </Border>
                    <TextBox x:Name="TxtContentB" Background="#121214" Foreground="#ECECEF" BorderThickness="0" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas, Segoe UI"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer / Legend -->
        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="12" Height="12" Background="#16A34A" CornerRadius="2" Margin="0,0,4,0"/>
                <TextBlock Text="Green: Added Lines" FontSize="10.5" Foreground="#A1A1AA" Margin="0,0,12,0"/>
                <Border Width="12" Height="12" Background="#DC2626" CornerRadius="2" Margin="0,0,4,0"/>
                <TextBlock Text="Red: Deleted Lines" FontSize="10.5" Foreground="#A1A1AA"/>
            </StackPanel>

            <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="16,5" FontWeight="SemiBold" FontSize="11" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
