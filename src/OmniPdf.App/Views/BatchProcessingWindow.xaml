<Window x:Class="OmniPdf.App.Views.BatchProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omni Studio Enterprise - Batch Processing &amp; Automation Hub"
        Height="540" Width="780" MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner" Background="#121214" Foreground="#ECECEF"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="*"/>    <!-- Queue List & Controls -->
            <RowDefinition Height="Auto"/> <!-- Configuration & Presets -->
            <RowDefinition Height="Auto"/> <!-- Progress & Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <Border Width="32" Height="32" CornerRadius="6" Background="#0284C7" Margin="0,0,10,0">
                    <TextBlock Text="⚡" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Batch Document Automation Engine" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                    <TextBlock Text="Convert, optimize, compress, and watermark multi-file batches concurrently" FontSize="11" Foreground="#A1A1AA"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Queue List -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="BATCH PROCESSING QUEUE" FontWeight="Bold" FontSize="10" Foreground="#71717A" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="➕ Add Files..." Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="8,3" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Click="BtnAddFiles_Click"/>
                        <Button Content="📂 Add Folder..." Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="8,3" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Click="BtnAddFolder_Click"/>
                        <Button Content="🧹 Clear All" Background="#27272A" Foreground="#EF4444" BorderBrush="#3F3F46" Padding="8,3" FontSize="11" FontWeight="SemiBold" Click="BtnClear_Click"/>
                    </StackPanel>
                </DockPanel>

                <ListBox x:Name="ListBatchQueue" Background="#121214" BorderBrush="#27272A" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4">
                                <TextBlock Text="📄" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" Foreground="#E4E4E7" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Operation Selection -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="SELECT BATCH ACTION" FontWeight="Bold" FontSize="10" Foreground="#71717A" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbBatchAction" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" FontSize="11" SelectedIndex="0">
                        <ComboBoxItem Content="Convert All to Microsoft Word (.docx)"/>
                        <ComboBoxItem Content="Convert All to Clean Markdown (.md)"/>
                        <ComboBoxItem Content="Convert All to Plain Text (.txt)"/>
                        <ComboBoxItem Content="Batch Linearize &amp; Web Optimize"/>
                        <ComboBoxItem Content="Batch Stamp Confidential Watermark"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="OUTPUT DESTINATION FOLDER" FontWeight="Bold" FontSize="10" Foreground="#71717A" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button Content="Browse..." DockPanel.Dock="Right" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="8,3" FontSize="11" Margin="6,0,0,0" Click="BtnBrowseOutput_Click"/>
                        <TextBox x:Name="TxtOutputDir" Text="C:\Users\Public\Documents\Omni_Batch_Output" Background="#121214" Foreground="White" BorderBrush="#3F3F46" Padding="5,3" FontSize="11"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress & Action -->
        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock x:Name="TxtBatchStatus" Text="Ready to process 0 documents" FontSize="11" Foreground="#A1A1AA"/>
                <ProgressBar x:Name="PbBatchProgress" Width="360" Height="8" Margin="0,4,0,0" Background="#27272A" Foreground="#0284C7" Minimum="0" Maximum="100"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Close" Background="#27272A" Foreground="White" BorderBrush="#3F3F46" Padding="14,6" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" Click="BtnClose_Click"/>
                <Button x:Name="BtnStartBatch" Content="⚡ Execute Batch Task" Background="#0284C7" Foreground="White" BorderBrush="#38BDF8" Padding="16,6" FontWeight="Bold" FontSize="11" Click="BtnStartBatch_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
